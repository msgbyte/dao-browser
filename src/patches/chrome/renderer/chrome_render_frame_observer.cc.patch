 void ChromeRenderFrameObserver::DidCreateNewDocument() {
+  auto* frame = render_frame()->GetWebFrame();
+  const auto& token = frame->GetDocument().Token();
+  const bool initial =
+      !frame->GetDocumentLoader()->HasLoadedNonInitialEmptyDocument();
+  if (home_storage_document_token_ == token && !initial) {
+    // Renderer-only replacements and the synchronous initial about:blank
+    // commit inherit the previous token. Only the latter remains initial.
+    dao::MarkHomeLocalStorageDocumentReplaced(
+        frame, home_storage_document_was_initial_);
+  } else {
+    home_storage_document_token_ = token;
+    home_storage_document_was_initial_ = initial;
+  }
