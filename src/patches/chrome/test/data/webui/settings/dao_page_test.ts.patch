+        '{\\n   "mcpServers": {\\n      "dao": {\\n         "command": "/Applications/Dao.app/Contents/Helpers/dao-mcp"\\n      }\\n   }\\n}\\n';
+    mcpBrowserProxy.resolveSetupContent('generic-mcp', configuration);
