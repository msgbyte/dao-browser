+    mcpBrowserProxy.resolveCopyContent('generic-mcp', true);
+    await flushTasks();
+    assertEquals(
+        loadTimeData.getString('daoMcpConfigurationCopied'),
+        feedback.textContent.trim());
+
+    sendMcpStatus({
+      enabled: false,
+      state: 'disabled',
+      canStop: false,
+    });
+    flush();
+    assertNull(page.shadowRoot!.querySelector('#daoMcpQuickSetup'));
+  });
