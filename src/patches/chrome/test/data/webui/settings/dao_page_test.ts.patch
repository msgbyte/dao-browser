+class TestDaoFolderBrowserProxy extends TestBrowserProxy implements
+    DaoFolderBrowserProxy {
+  categories: DaoTabCategory[] = [{id: 'work', name: 'Work'}];
+  fail = false;
+
+  constructor() {
+    super(['getCategories', 'editCategory']);
+  }
+
+  getCategories(): Promise<DaoTabCategory[]> {
+    this.methodCalled('getCategories');
+    return this.fail ? Promise.reject() : Promise.resolve(this.categories);
+  }
+
+  editCategory(operation: 'add'|'rename'|'remove', id: string, name: string):
+      Promise<DaoTabCategory[]> {
+    this.methodCalled('editCategory', [operation, id, name]);
+    return this.fail ? Promise.reject() : Promise.resolve(this.categories);
+  }
+}
