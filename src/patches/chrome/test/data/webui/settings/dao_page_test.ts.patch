+    assertEquals(
+        'claude-code',
+        await mcpBrowserProxy.whenCalled('copyDaoMcpSetupContent'));
+    mcpBrowserProxy.resolveCopyContent('claude-code', true);
+    await flushTasks();
+    const feedback = page.shadowRoot!.querySelector<HTMLElement>(
+        '#daoMcpSetupFeedback');
+    assertTrue(!!feedback);
+    assertEquals(
+        loadTimeData.getString('daoMcpInstallCommandCopied'),
