+
+import 'chrome://settings/settings.js';
+import 'chrome://settings/lazy_load.js';
+
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {webUIListenerCallback} from 'chrome://resources/js/cr.js';
+import {flush} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+import type {
+  DaoMcpBrowserProxy,
+  DaoMcpStatus,
+  SettingsDaoPageElement,
+  SettingsToggleButtonElement,
+} from 'chrome://settings/settings.js';
+import {
+  DaoMcpBrowserProxyImpl,
+  loadTimeData,
+  OpenWindowProxyImpl,
+  Router,
+  routes,
+} from 'chrome://settings/settings.js';
+import {
+  ContentSetting,
+  ContentSettingsTypes,
+  SiteSettingsBrowserProxyImpl,
+} from 'chrome://settings/lazy_load.js';
+import {
+  assertEquals,
+  assertFalse,
+  assertNull,
+  assertTrue,
+} from 'chrome://webui-test/chai_assert.js';
+import {flushTasks} from 'chrome://webui-test/polymer_test_util.js';
+import {TestBrowserProxy} from 'chrome://webui-test/test_browser_proxy.js';
+import {TestOpenWindowProxy} from 'chrome://webui-test/test_open_window_proxy.js';
+
+import {TestSiteSettingsBrowserProxy} from './test_site_settings_browser_proxy.js';
+import {
+  createContentSettingTypeToValuePair,
+  createSiteSettingsPrefs,
+} from './test_util.js';
+
+type DaoMcpSetupOption = 'codex'|'claude-code'|'generic-mcp';
+
+class TestDaoMcpBrowserProxy extends TestBrowserProxy implements
+    DaoMcpBrowserProxy {
+  private status_: DaoMcpStatus = {
+    enabled: false,
+    state: 'disabled',
+    canStop: false,
+  };
+  private setupContentResolvers_ =
+      new Map<DaoMcpSetupOption, (content: string) => void>();
+  private copyContentResolvers_ =
+      new Map<DaoMcpSetupOption, (copied: boolean) => void>();
+
+  constructor() {
+    super([
+      'getDaoMcpStatus',
+      'setDaoMcpEnabled',
+      'getDaoMcpSetupContent',
+      'copyDaoMcpSetupContent',
+      'stopDaoMcpControl',
+    ]);
+  }
+
+  getDaoMcpStatus(): Promise<DaoMcpStatus> {
+    this.methodCalled('getDaoMcpStatus');
+    return Promise.resolve(this.status_);
+  }
+
+  setDaoMcpEnabled(enabled: boolean): void {
+    this.methodCalled('setDaoMcpEnabled', enabled);
+  }
+
+  getDaoMcpSetupContent(option: DaoMcpSetupOption): Promise<string> {
+    this.methodCalled('getDaoMcpSetupContent', option);
+    return new Promise(resolve => {
+      this.setupContentResolvers_.set(option, resolve);
+    });
+  }
+
+  copyDaoMcpSetupContent(option: DaoMcpSetupOption): Promise<boolean> {
+    this.methodCalled('copyDaoMcpSetupContent', option);
+    return new Promise(resolve => {
+      this.copyContentResolvers_.set(option, resolve);
+    });
+  }
+
+  resolveSetupContent(option: DaoMcpSetupOption, content: string) {
+    const resolve = this.setupContentResolvers_.get(option);
+    assertTrue(!!resolve);
+    this.setupContentResolvers_.delete(option);
+    resolve(content);
+  }
+
+  resolveCopyContent(option: DaoMcpSetupOption, copied: boolean) {
+    const resolve = this.copyContentResolvers_.get(option);
+    assertTrue(!!resolve);
+    this.copyContentResolvers_.delete(option);
+    resolve(copied);
+  }
+
+  stopDaoMcpControl(): void {
+    this.methodCalled('stopDaoMcpControl');
+  }
+}
+
+suite('DaoPage', function() {
+  let page: SettingsDaoPageElement;
+  let mcpBrowserProxy: TestDaoMcpBrowserProxy;
+  let openWindowProxy: TestOpenWindowProxy;
+  let siteSettingsBrowserProxy: TestSiteSettingsBrowserProxy;
+
+  setup(async function() {
+    mcpBrowserProxy = new TestDaoMcpBrowserProxy();
+    DaoMcpBrowserProxyImpl.setInstance(mcpBrowserProxy);
+    openWindowProxy = new TestOpenWindowProxy();
+    OpenWindowProxyImpl.setInstance(openWindowProxy);
+    siteSettingsBrowserProxy = new TestSiteSettingsBrowserProxy();
+    siteSettingsBrowserProxy.setPrefs(createSiteSettingsPrefs([
+      createContentSettingTypeToValuePair(
+          ContentSettingsTypes.AUTO_PICTURE_IN_PICTURE,
+          {setting: ContentSetting.ASK}),
+    ], []));
+    SiteSettingsBrowserProxyImpl.setInstance(siteSettingsBrowserProxy);
+    document.body.innerHTML = window.trustedTypes!.emptyHTML;
+    page = document.createElement('settings-dao-page');
+    page.prefs = {
+      dao: {
+        enhanced_command_bar_suggestions_enabled: {
+          key: 'dao.enhanced_command_bar_suggestions_enabled',
+          type: chrome.settingsPrivate.PrefType.BOOLEAN,
+          value: false,
+        },
+        ask_ai_enabled: {
+          key: 'dao.ask_ai_enabled',
+          type: chrome.settingsPrivate.PrefType.BOOLEAN,
+          value: true,
+        },
+        stale_tab_expiration_hours: {
+          key: 'dao.stale_tab_expiration_hours',
+          type: chrome.settingsPrivate.PrefType.NUMBER,
+          value: 24,
+        },
+        enhanced_pip_enabled: {
+          key: 'dao.enhanced_pip_enabled',
+          type: chrome.settingsPrivate.PrefType.BOOLEAN,
+          value: true,
+        },
+        little_dao_enabled: {
+          key: 'dao.little_dao_enabled',
+          type: chrome.settingsPrivate.PrefType.BOOLEAN,
+          value: true,
+        },
+      },
+    };
+    document.body.appendChild(page);
+    await mcpBrowserProxy.whenCalled('getDaoMcpStatus');
+    await flushTasks();
+    flush();
+  });
+
+  teardown(function() {
+    page.remove();
+  });
+
+  function getMcpToggle(): SettingsToggleButtonElement {
+    const toggle =
+        page.shadowRoot!.querySelector<SettingsToggleButtonElement>(
+            '#daoMcpServerEnabled');
+    assertTrue(!!toggle);
+    return toggle;
+  }
+
+  function sendMcpStatus(status: DaoMcpStatus) {
+    webUIListenerCallback('dao-mcp-status-changed', status);
+    flush();
+  }
+
+  test('mcpMasterSwitchDefaultsOff', function() {
+    const toggle = getMcpToggle();
+    assertEquals('dao.mcp_server_enabled', toggle.pref!.key);
+    assertFalse(toggle.checked);
+  });
+
+  test('mcpMasterSwitchSendsRequestedState', async function() {
+    const toggle = getMcpToggle();
+    toggle.checked = true;
+    toggle.notifyChangedByUserInteraction();
+
+    assertTrue(await mcpBrowserProxy.whenCalled('setDaoMcpEnabled'));
+  });
+
+  test('mcpRendersDisabledReadyAndApprovalRequestedStates', function() {
+    const status =
+        page.shadowRoot!.querySelector<HTMLElement>('#daoMcpStatusValue');
+    assertTrue(!!status);
+    assertEquals(loadTimeData.getString('daoMcpStatusDisabled'), status.textContent.trim());
+
+    sendMcpStatus({
+      enabled: true,
+      state: 'ready',
+      canStop: false,
+    });
+    assertEquals(loadTimeData.getString('daoMcpStatusReady'), status.textContent.trim());
+
+    sendMcpStatus({
+      enabled: true,
+      state: 'approval_requested',
+      canStop: false,
+    });
+    assertEquals(
+        loadTimeData.getString('daoMcpStatusApprovalRequested'),
+        status.textContent.trim());
+    assertNull(page.shadowRoot!.querySelector('#daoMcpClient'));
+    assertNull(page.shadowRoot!.querySelector('#daoMcpStopControl'));
+  });
+
+  test('mcpShowsClientAndStopOnlyWhileConnected', function() {
+    sendMcpStatus({
+      enabled: true,
+      state: 'approval_requested',
+      clientName: 'Should not render',
+      clientPid: 99,
+      canStop: false,
+    });
+    assertNull(page.shadowRoot!.querySelector('#daoMcpClient'));
+    assertNull(page.shadowRoot!.querySelector('#daoMcpStopControl'));
+
+    sendMcpStatus({
+      enabled: true,
+      state: 'connected',
+      clientName: 'Codex',
+      clientPid: 12345,
+      canStop: true,
+    });
+
+    const status =
+        page.shadowRoot!.querySelector<HTMLElement>('#daoMcpStatusValue');
+    assertTrue(!!status);
+    assertEquals(
+        loadTimeData.getString('daoMcpStatusConnected'),
+        status.textContent.trim());
+    const client =
+        page.shadowRoot!.querySelector<HTMLElement>('#daoMcpClient');
+    assertTrue(!!client);
+    assertEquals(
+        loadTimeData.getStringF('daoMcpClientDetails', 'Codex', '12345'),
+        client.textContent.trim());
+    assertTrue(
+        !!page.shadowRoot!.querySelector('#daoMcpStopControl'));
+
+    sendMcpStatus({
+      enabled: true,
+      state: 'ready',
+      canStop: false,
+    });
+    assertNull(page.shadowRoot!.querySelector('#daoMcpClient'));
+    assertNull(page.shadowRoot!.querySelector('#daoMcpStopControl'));
+  });
+
+  test('mcpQuickSetupPreviewsAndCopiesSelectedClient', async function() {
+    assertNull(page.shadowRoot!.querySelector('#daoMcpQuickSetup'));
+
+    sendMcpStatus({
+      enabled: true,
+      state: 'ready',
+      canStop: false,
+    });
+    flush();
+    const codexCommand =
+        "codex mcp add dao -- '/Applications/Dao.app/Contents/Helpers/dao-mcp'";
+    mcpBrowserProxy.resolveSetupContent('codex', codexCommand);
+    await flushTasks();
+
+    const quickSetup =
+        page.shadowRoot!.querySelector<HTMLElement>('#daoMcpQuickSetup');
+    const selector =
+        page.shadowRoot!.querySelector<HTMLSelectElement>(
+            '#daoMcpClientSelector');
+    const preview =
+        page.shadowRoot!.querySelector<HTMLElement>(
+            '#daoMcpSetupPreview');
+    assertTrue(
+        !!page.shadowRoot!.querySelector('#daoMcpConnectionSection'));
+    const setupControls =
+        page.shadowRoot!.querySelector<HTMLElement>('#daoMcpSetupControls');
+    assertTrue(!!setupControls);
+    assertNull(page.shadowRoot!.querySelector('.dao-mcp-title'));
+    assertTrue(!!quickSetup);
+    assertTrue(!!selector);
+    assertTrue(!!preview);
+    assertEquals('codex', selector.value);
+    assertEquals(codexCommand, preview.textContent.trim());
+
+    selector.value = 'claude-code';
+    selector.dispatchEvent(new Event('change'));
+    const claudeCommand =
+        "claude mcp add --scope user dao -- '/Applications/Dao.app/Contents/Helpers/dao-mcp'";
+    mcpBrowserProxy.resolveSetupContent('claude-code', claudeCommand);
+    await flushTasks();
+    assertEquals(claudeCommand, preview.textContent.trim());
+
+    page.shadowRoot!
+        .querySelector<HTMLElement>('#daoMcpCopySetup')!.click();
+    assertEquals(
+        'claude-code',
+        await mcpBrowserProxy.whenCalled('copyDaoMcpSetupContent'));
+    mcpBrowserProxy.resolveCopyContent('claude-code', true);
+    await flushTasks();
+    const feedback = page.shadowRoot!.querySelector<HTMLElement>(
+        '#daoMcpSetupFeedback');
+    assertTrue(!!feedback);
+    assertEquals(
+        loadTimeData.getString('daoMcpInstallCommandCopied'),
+        feedback.textContent.trim());
+
+    selector.value = 'generic-mcp';
+    selector.dispatchEvent(new Event('change'));
+    const configuration =
+        '{\\n   "mcpServers": {\\n      "dao": {\\n         "command": "/Applications/Dao.app/Contents/Helpers/dao-mcp"\\n      }\\n   }\\n}\\n';
+    mcpBrowserProxy.resolveSetupContent('generic-mcp', configuration);
+    await flushTasks();
+    assertEquals(configuration.trim(), preview.textContent.trim());
+    assertEquals(
+        '{\\n   "mcpServers": {', preview.textContent.trim().slice(0, 20));
+
+    page.shadowRoot!
+        .querySelector<HTMLElement>('#daoMcpCopySetup')!.click();
+    assertEquals(
+        'generic-mcp',
+        await mcpBrowserProxy.whenCalled('copyDaoMcpSetupContent'));
+    mcpBrowserProxy.resolveCopyContent('generic-mcp', true);
+    await flushTasks();
+    assertEquals(
+        loadTimeData.getString('daoMcpConfigurationCopied'),
+        feedback.textContent.trim());
+
+    sendMcpStatus({
+      enabled: false,
+      state: 'disabled',
+      canStop: false,
+    });
+    flush();
+    assertNull(page.shadowRoot!.querySelector('#daoMcpQuickSetup'));
+  });
+
+  test('mcpQuickSetupIgnoresStalePreviewResponse', async function() {
+    sendMcpStatus({
+      enabled: true,
+      state: 'ready',
+      canStop: false,
+    });
+    flush();
+    const selector =
+        page.shadowRoot!.querySelector<HTMLSelectElement>(
+            '#daoMcpClientSelector')!;
+    selector.value = 'claude-code';
+    selector.dispatchEvent(new Event('change'));
+
+    mcpBrowserProxy.resolveSetupContent('claude-code', 'claude command');
+    await flushTasks();
+    mcpBrowserProxy.resolveSetupContent('codex', 'stale codex command');
+    await flushTasks();
+
+    const preview = page.shadowRoot!.querySelector<HTMLElement>(
+        '#daoMcpSetupPreview')!;
+    assertEquals('claude command', preview.textContent.trim());
+  });
+
+  test('mcpQuickSetupIgnoresCopyCompletionAfterDisableAndReenable',
+      async function() {
+    const codexCommand = 'codex command';
+    sendMcpStatus({
+      enabled: true,
+      state: 'ready',
+      canStop: false,
+    });
+    mcpBrowserProxy.resolveSetupContent('codex', codexCommand);
+    await flushTasks();
+
+    page.shadowRoot!
+        .querySelector<HTMLElement>('#daoMcpCopySetup')!.click();
+    assertEquals(
+        'codex', await mcpBrowserProxy.whenCalled('copyDaoMcpSetupContent'));
+
+    sendMcpStatus({
+      enabled: false,
+      state: 'disabled',
+      canStop: false,
+    });
+    sendMcpStatus({
+      enabled: true,
+      state: 'ready',
+      canStop: false,
+    });
+    mcpBrowserProxy.resolveCopyContent('codex', true);
+    mcpBrowserProxy.resolveSetupContent('codex', codexCommand);
+    await flushTasks();
+
+    const feedback = page.shadowRoot!.querySelector<HTMLElement>(
+        '#daoMcpSetupFeedback');
+    assertTrue(!!feedback);
+    assertEquals('', feedback.textContent.trim());
+  });
+
+  test('mcpQuickSetupDeclaresNarrowControlStacking', async function() {
+    sendMcpStatus({
+      enabled: true,
+      state: 'ready',
+      canStop: false,
+    });
+    mcpBrowserProxy.resolveSetupContent('codex', 'codex command');
+    await flushTasks();
+
+    const style = page.shadowRoot!.querySelector<HTMLStyleElement>('style');
+    assertTrue(!!style && !!style.sheet);
+    const narrowRule = Array.from(style.sheet.cssRules).find(
+        (rule): rule is CSSMediaRule =>
+            rule instanceof CSSMediaRule &&
+            rule.conditionText === '(max-width: 520px)');
+    assertTrue(!!narrowRule);
+    const controlsRule = Array.from(narrowRule.cssRules).find(
+        (rule): rule is CSSStyleRule =>
+            rule instanceof CSSStyleRule &&
+            rule.selectorText === '.dao-mcp-setup-controls');
+    assertTrue(!!controlsRule);
+    assertEquals('column', controlsRule.style.flexDirection);
+  });
+
+  test('mcpHasNoStandaloneCopyConfigButton', function() {
+    assertNull(page.shadowRoot!.querySelector('#daoMcpCopyConfig'));
+  });
+
+  test('mcpStopCallsHandlerWhenLeaseIsActive', async function() {
+    sendMcpStatus({
+      enabled: true,
+      state: 'connected',
+      clientName: 'Codex',
+      clientPid: 12345,
+      canStop: true,
+    });
+    const button =
+        page.shadowRoot!.querySelector<HTMLElement>('#daoMcpStopControl');
+    assertTrue(!!button);
+    button.click();
+
+    await mcpBrowserProxy.whenCalled('stopDaoMcpControl');
+  });
+
+  test('littleDaoToggleBindsToDaoPref', function() {
+    const toggle =
+        page.shadowRoot!.querySelector<SettingsToggleButtonElement>(
+            '#littleDaoEnabled');
+    assertTrue(!!toggle);
+    assertEquals('dao.little_dao_enabled', toggle.pref!.key);
+    assertTrue(toggle.checked);
+  });
+
+  test('importBrowserDataOpensStandaloneMigration', async function() {
+    const importRow =
+        page.shadowRoot!.querySelector<HTMLElement>('#importBrowserData');
+    assertTrue(!!importRow);
+    importRow.click();
+
+    assertEquals(
+        'dao://import/', await openWindowProxy.whenCalled('openUrl'));
+  });
+
+  test('enhancedCommandBarSuggestionsToggleBindsToDaoPref', function() {
+    const toggle =
+        page.shadowRoot!.querySelector<SettingsToggleButtonElement>(
+            '#enhancedCommandBarSuggestionsEnabled');
+    assertTrue(!!toggle);
+    assertEquals(
+        'dao.enhanced_command_bar_suggestions_enabled', toggle.pref!.key);
+    assertTrue(!toggle.checked);
+  });
+
+  test('askAiToggleBindsToDaoPref', function() {
+    const toggle =
+        page.shadowRoot!.querySelector<SettingsToggleButtonElement>(
+            '#askAiEnabled');
+    assertTrue(!!toggle);
+    assertEquals('dao.ask_ai_enabled', toggle.pref!.key);
+    assertTrue(toggle.checked);
+  });
+
+  test('enhancedPipToggleBindsToDaoPref', function() {
+    const toggle =
+        page.shadowRoot!.querySelector<SettingsToggleButtonElement>(
+            '#enhancedPipEnabled');
+    assertTrue(!!toggle);
+    assertEquals('dao.enhanced_pip_enabled', toggle.pref!.key);
+    assertTrue(toggle.checked);
+  });
+
+  test('autoPipToggleUsesNativeContentSetting', async function() {
+    const toggle =
+        page.shadowRoot!.querySelector<SettingsToggleButtonElement>(
+            '#autoPipEnabled');
+    assertTrue(!!toggle);
+    assertEquals(
+        ContentSettingsTypes.AUTO_PICTURE_IN_PICTURE,
+        await siteSettingsBrowserProxy.whenCalled(
+            'getDefaultValueForContentType'));
+    assertTrue(toggle.checked);
+
+    toggle.click();
+    let [category, setting] = await siteSettingsBrowserProxy.whenCalled(
+        'setDefaultValueForContentType');
+    assertEquals(ContentSettingsTypes.AUTO_PICTURE_IN_PICTURE, category);
+    assertEquals(ContentSetting.BLOCK, setting);
+
+    siteSettingsBrowserProxy.resetResolver(
+        'setDefaultValueForContentType');
+    toggle.click();
+    [category, setting] = await siteSettingsBrowserProxy.whenCalled(
+        'setDefaultValueForContentType');
+    assertEquals(ContentSettingsTypes.AUTO_PICTURE_IN_PICTURE, category);
+    assertEquals(ContentSetting.ASK, setting);
+  });
+
+  test('staleTabExpirationInputSavesValidInteger', function() {
+    const input = page.shadowRoot!.querySelector<CrInputElement>(
+        '#staleTabExpirationHours');
+    assertTrue(!!input);
+    assertEquals('24', input.value);
+
+    input.value = '48';
+    input.dispatchEvent(new Event('input', {bubbles: true, composed: true}));
+    input.dispatchEvent(new Event('change', {bubbles: true, composed: true}));
+    flush();
+
+    assertFalse(input.invalid);
+    assertEquals(48, page.prefs['dao'].stale_tab_expiration_hours.value);
+  });
+
+  test('staleTabExpirationInputRejectsInvalidValue', function() {
+    const input = page.shadowRoot!.querySelector<CrInputElement>(
+        '#staleTabExpirationHours');
+    assertTrue(!!input);
+
+    input.value = '0';
+    input.dispatchEvent(new Event('input', {bubbles: true, composed: true}));
+    input.dispatchEvent(new Event('change', {bubbles: true, composed: true}));
+    flush();
+
+    assertTrue(input.invalid);
+    assertEquals(24, page.prefs['dao'].stale_tab_expiration_hours.value);
+  });
+
+  test('staleTabExpirationUnitIsInlineInputSuffix', function() {
+    const input = page.shadowRoot!.querySelector<CrInputElement>(
+        '#staleTabExpirationHours');
+    assertTrue(!!input);
+    assertTrue(!!input.querySelector('[slot="inline-suffix"]'));
+  });
+
+  test('enhancedPipPreviewShowsSelectedModeOnly', function() {
+    const preview = page.shadowRoot!.querySelector('#enhancedPipPreview');
+    assertTrue(!!preview);
+    assertTrue(!!preview.querySelector('#enhancedPipPreviewOn'));
+    assertTrue(!preview.querySelector('#enhancedPipPreviewOff'));
+    assertTrue(!!preview.querySelector('#enhancedPipPreviewSubtitles'));
+    assertTrue(!preview.querySelector('#enhancedPipPreviewOriginalWindow'));
+    assertTrue(!preview.querySelector('#enhancedPipPreviewOriginalVideo'));
+
+    page.set('prefs.dao.enhanced_pip_enabled.value', false);
+    flush();
+    assertTrue(!preview.querySelector('#enhancedPipPreviewOn'));
+    assertTrue(!preview.querySelector('#enhancedPipPreviewSubtitles'));
+    assertTrue(!!preview.querySelector('#enhancedPipPreviewOff'));
+    assertTrue(!!preview.querySelector('#enhancedPipPreviewOriginalWindow'));
+    assertTrue(!!preview.querySelector('#enhancedPipPreviewOriginalVideo'));
+  });
+
+  test('routeIsIndependentDaoSection', function() {
+    assertEquals('/dao', routes.DAO.path);
+    assertEquals('dao', routes.DAO.section);
+    assertEquals('daoPageTitle', routes.DAO.title);
+  });
+
+  test('navigatesToDaoRoute', function() {
+    Router.getInstance().navigateTo(routes.DAO);
+    assertEquals(routes.DAO, Router.getInstance().getCurrentRoute());
+  });
+});
