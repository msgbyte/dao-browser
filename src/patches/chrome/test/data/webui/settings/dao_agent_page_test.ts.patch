+
+  test('resetSuccessRefreshFailureDoesNotSuggestResettingAgain',
+      async function() {
+        await resolveAllManagementSummaries();
+        const resetButton = page.shadowRoot!.querySelector<HTMLElement>(
+            '#resetUsageStatsButton')!;
+        const resetDialog = page.shadowRoot!.querySelector<HTMLElement & {
+          open: boolean,
+        }>('#resetUsageStatsDialog')!;
+        const confirm = resetDialog.querySelector<HTMLElement & {
+          disabled: boolean,
+        }>('#resetUsageStatsConfirm')!;
+
