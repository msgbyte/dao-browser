+bool IsSameOrParentIgnoringCase(const base::FilePath& parent,
+                              base::FilePath child) {
+  for (;;) {
+    if (base::FilePath::CompareEqualIgnoreCase(parent.value(), child.value())) {
+      return true;
+    }
+    const base::FilePath next = child.DirName();
+    if (next == child) {
+      return false;
+    }
+    child = next;
+  }
+}
+
+// The wizard selects a per-user product root; Chromium owns its Application
+// child. Keep it outside system locations because runtime install scope is
+// inferred from Program Files. Never silently fall back after invalid input.
+base::FilePath GetDaoInstallPath(const base::FilePath& requested,
+                               bool system_install) {
+  const base::FilePath root =
+      requested.NormalizePathSeparators().StripTrailingSeparators();
+  const std::wstring& value = root.value();
+  if (system_install || !root.IsAbsolute() || root.ReferencesParent() ||
+      value.size() < 4 || value.size() > 180 || value[1] != L':' ||
+      value[2] != L'\\' || value.substr(3).find_first_of(L":*?\"<>|") !=
+                                std::wstring::npos) {
+    return {};
+  }
+  if (::GetDriveTypeW((value.substr(0, 3)).c_str()) != DRIVE_FIXED) {
+    return {};
+  }
+  for (const auto& component : root.GetComponents()) {
+    if (component == L"." || component.back() == L'.' ||
+        component.back() == L' ') {
+      return {};
+    }
+  }
+  for (int key : {base::DIR_PROGRAM_FILES, base::DIR_PROGRAM_FILESX86,
+                 base::DIR_PROGRAM_FILES6432, base::DIR_WINDOWS}) {
+    base::FilePath reserved;
+    if (base::PathService::Get(key, &reserved) &&
+        IsSameOrParentIgnoringCase(reserved, root)) {
+      return {};
+    }
+  }
+  const base::FilePath profile =
+      GetDefaultChromeInstallPathChecked(false).DirName().Append(L"User Data");
+  if (IsSameOrParentIgnoringCase(profile, root)) {
+    return {};
+  }
+  return root.Append(installer::kInstallBinaryDir);
+}
