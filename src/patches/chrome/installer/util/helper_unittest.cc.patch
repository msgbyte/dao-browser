+TEST_P(GetChromeInstallPathWithPrefsTest, DaoPreservesUnrelatedFiles) {
+  const base::FilePath root = random_path().Append(L"Other application");
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitchPath(kDaoInstallDir, root);
+  for (const auto* name : {kInstallBinaryDir, kInstallTempDir}) {
+    const base::FilePath owned = root.Append(name);
+    ASSERT_TRUE(base::CreateDirectory(owned));
+    ASSERT_TRUE(base::WriteFile(owned.Append(L"important.txt"), "keep"));
+    EXPECT_TRUE(GetChromeInstallPathWithPrefs(is_system_level(),
+                                             InitialPreferences(prefs_json()))
+                    .empty());
+    ASSERT_TRUE(base::DeletePathRecursively(owned));
+  }
+}
