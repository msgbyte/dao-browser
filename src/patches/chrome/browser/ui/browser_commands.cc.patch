+  ToastController* toast_controller = browser->GetFeatures().toast_controller();
+  tabs::TabInterface* tab = browser->GetTabStripModel()->GetActiveTab();
+  const bool single_pinned_tab_selected =
+      tab->IsPinned() &&
+      browser->GetTabStripModel()->selection_model().size() == 1;
+  bool close_after_confirmation = false;
+  if (single_pinned_tab_selected) {
+    BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+    dao::DaoToastView* dao_toast =
+        browser_view ? browser_view->dao_toast() : nullptr;
+    if (dao_toast) {
+      ui::Accelerator accelerator;
+      CHECK(browser_view->GetAcceleratorForCommandId(IDC_CLOSE_TAB,
+                                                     &accelerator));
+      const std::u16string message = l10n_util::GetStringFUTF16(
+          IDS_CLOSE_PINNED_TAB_TOAST_BODY, accelerator.GetShortcutText());
+      if (!dao_toast->IsShowingToast(message)) {
+        dao_toast->ShowToast(message);
+        return;
+      }
+      close_after_confirmation = true;
+    } else if (toast_controller &&
+               toast_controller->GetCurrentToastId() !=
+                   ToastId::kClosePinnedTab) {
+      CHECK(browser_view);
+      ui::Accelerator accelerator;
+      CHECK(browser_view->GetAcceleratorForCommandId(IDC_CLOSE_TAB,
+                                                     &accelerator));
+
+      ToastParams params(ToastId::kClosePinnedTab);
+      params.body_string_replacement_params.emplace_back(
+          accelerator.GetShortcutText());
+      toast_controller->MaybeShowToast(std::move(params));
+      return;
+    } else if (toast_controller) {
+      close_after_confirmation = true;
+    }
+  }
+
+  CloseSelectedTabAndRecordTabCountMetric(browser);
+  if (close_after_confirmation) {
