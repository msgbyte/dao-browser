   if (WindowFeatureController::From(browser)->SupportsWindowFeature(
           WindowFeatureController::WindowFeature::kFeatureTabStrip)) {
+    // Dao: For a sidebar window driven by a user gesture (Cmd+T, "File > New
+    // Tab" menu, new-tab-button), DON'T actually open a blank tab. Instead,
+    // overlay the Spotlight-style command bar on the CURRENT page. If the
+    // user types a URL and commits, DaoCommandBarView::Navigate() creates a
+    // new tab itself (is_new_tab_mode_ path); if the user Esc's, nothing
+    // changed on screen. Programmatic NewTab calls (kNoUserAction — session
+    // restore, tests, middle-click intents) still create a real tab.
+    if (context != NewTabTypes::kNoUserAction) {
+      if (BrowserView* bv =
+              BrowserView::GetBrowserViewForBrowser(browser);
+          bv && bv->dao_sidebar() && bv->dao_sidebar()->GetVisible() &&
+          bv->dao_command_bar()) {
+        bv->dao_command_bar()->ShowForNewTab();
+        // Function signature mandates returning a WebContents&. Return the
+        // currently-active tab — callers that actually use this return
+        // value (e.g. certain tests) will see an existing tab rather than a
+        // freshly-added one. This is acceptable because the only user-gesture
+        // call sites in production are chrome::ExecuteCommand for IDC_NEW_TAB
+        // and the new-tab button, neither of which uses the return value.
+        content::WebContents* active =
+            browser->GetTabStripModel()->GetActiveWebContents();
+        if (active) {
+          return *active;
+        }
+      }
+    }
+
     return *AddAndReturnTabAt(browser, GURL(), -1, /*foreground=*/true,
                               std::nullopt, /*pinned=*/false, window_action);
   }
