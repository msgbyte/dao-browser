+const views::View* WindowsCaptionButton::GetDaoCaptionSurface() const {
+  auto* browser_view = frame_view_->GetBrowserView();
+  if (!browser_view->GetIsNormalType()) {
+    return nullptr;
+  }
+  // Each button can overlap a different surface while the Agent animates.
+  const gfx::Point center = GetBoundsInScreen().CenterPoint();
+  if (auto* agent = browser_view->dao_agent_sidebar();
+      agent && agent->GetVisible() &&
+      agent->GetBoundsInScreen().Contains(center)) {
+    return agent;
+  }
+  if (auto* split = browser_view->dao_split_view();
+      split && split->GetVisible()) {
+    for (views::View* child : split->children()) {
+      if (auto* pane = views::AsViewClass<dao::DaoSplitPaneView>(child);
+          pane && pane->GetVisible() &&
+          pane->address_bar()->GetBoundsInScreen().Contains(center)) {
+        return pane->address_bar();
+      }
+    }
+  }
+  return browser_view->dao_address_bar();
+}
