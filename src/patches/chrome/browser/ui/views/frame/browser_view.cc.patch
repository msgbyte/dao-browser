+      gfx::Rect bounds = gfx::ToEnclosingRect(gfx::RectF(
+          params.visual_client_area.right() - size.width(),
+          params.visual_client_area.y(), size.width(), size.height()));
+      bounds = views::View::ConvertRectToTarget(frame, this, bounds);
+      return bounds;
+    }
+  }
