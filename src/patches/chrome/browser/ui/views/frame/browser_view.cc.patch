+gfx::Rect BrowserView::GetDaoWindowControlsBounds() const {
+#if BUILDFLAG(IS_WIN)
+  if (dao_sidebar_ && GetWidget() && !GetWidget()->IsFullscreen()) {
+    auto* frame = browser_widget_->GetFrameView();
+    const auto params = frame->GetBrowserLayoutParams();
