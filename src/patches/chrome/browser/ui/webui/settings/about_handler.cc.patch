+
+void AboutHandler::OnDaoUpdateStatusChanged(const dao::DaoUpdateStatus& status) {
+  if (!IsJavascriptAllowed()) return;
+  int message = IDS_DAO_UPDATE_IDLE;
+  using State = dao::DaoUpdateState;
+  switch (status.state) {
+    case State::kIdle: break;
+    case State::kChecking: message = IDS_DAO_UPDATE_CHECKING; break;
+    case State::kDownloading: message = IDS_DAO_UPDATE_DOWNLOADING; break;
+    case State::kUpToDate: message = IDS_DAO_UPDATE_CURRENT; break;
+    case State::kReady: message = IDS_DAO_UPDATE_READY; break;
+    case State::kApplying: message = IDS_DAO_UPDATE_APPLYING; break;
+    case State::kUnsupported: message = IDS_DAO_UPDATE_UNSUPPORTED; break;
+    case State::kError:
+      message = status.error == dao::DaoUpdateError::kVerification ? IDS_DAO_UPDATE_VERIFY_ERROR :
+                status.error == dao::DaoUpdateError::kInstall ? IDS_DAO_UPDATE_INSTALL_ERROR :
+                IDS_DAO_UPDATE_NETWORK_ERROR;
+      break;
+  }
+  base::DictValue value;
+  value.Set("message", l10n_util::GetStringUTF16(message));
+  value.Set("busy", status.state == State::kChecking || status.state == State::kDownloading ||
+                    status.state == State::kApplying || status.state == State::kUnsupported);
+  value.Set("ready", status.state == State::kReady);
+  FireWebUIListener("dao-update-status-changed", value);
+}
 
