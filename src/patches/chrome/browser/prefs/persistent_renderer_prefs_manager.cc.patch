+
+content::RenderFrameHost* PersistentRendererPrefsManager::GetJsonPreviewFrame() {
+  content::RenderFrameHost* frame =
+      receivers_.current_context().AsRenderFrameHostIfValid();
+  if (!frame || !frame->IsActive() || !frame->IsInPrimaryMainFrame() ||
+      !blink::IsJSONMimeType(frame->GetPage().GetContentsMimeType())) {
+    return nullptr;
+  }
+  return frame;
+}
+
+void PersistentRendererPrefsManager::GetJsonPreviewPrettyPrint(
+    GetJsonPreviewPrettyPrintCallback callback) {
+  content::RenderFrameHost* frame = GetJsonPreviewFrame();
+  std::move(callback).Run(
+      frame && Profile::FromBrowserContext(frame->GetBrowserContext())
+                   ->GetPrefs()
+                   ->GetBoolean(dao::prefs::kDaoJsonPreviewPrettyPrint));
+}
+
+void PersistentRendererPrefsManager::SetJsonPreviewPrettyPrint(bool value) {
+  content::RenderFrameHost* frame = GetJsonPreviewFrame();
+  if (frame && frame->HasTransientUserActivation()) {
+    Profile::FromBrowserContext(frame->GetBrowserContext())
+        ->GetPrefs()
+        ->SetBoolean(dao::prefs::kDaoJsonPreviewPrettyPrint, value);
+  }
 }
 
