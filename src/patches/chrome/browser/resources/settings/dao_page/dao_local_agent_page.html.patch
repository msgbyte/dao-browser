diff --git a/chrome/browser/resources/settings/dao_page/dao_local_agent_page.html b/chrome/browser/resources/settings/dao_page/dao_local_agent_page.html
new file mode 100644
index 0000000000..0000000001
--- /dev/null
+++ b/chrome/browser/resources/settings/dao_page/dao_local_agent_page.html
@@ -0,0 +1,385 @@
+<style include="settings-shared">
+  .dao-mcp-page {
+    margin-top: 12px;
+  }
+
+  .dao-mcp-page-url {
+    overflow-wrap: anywhere;
+  }
+
+  .dao-mcp-settings,
+  .dao-local-agent-settings {
+    border: 1px solid var(--cr-separator-color);
+    border-radius: 12px;
+    margin: 16px 20px 20px;
+    overflow: hidden;
+  }
+
+  #daoMcpServerEnabled {
+    padding: 4px 16px;
+  }
+
+  .dao-mcp-section {
+    border-top: var(--cr-separator-line);
+    padding: 16px;
+  }
+
+  .dao-mcp-status-section,
+  .dao-mcp-setup-controls {
+    align-items: flex-end;
+    display: flex;
+    gap: 12px;
+    justify-content: space-between;
+  }
+
+  .dao-mcp-status-copy,
+  .dao-mcp-client-field {
+    flex: 1;
+    min-width: 0;
+  }
+
+  .dao-mcp-section-title,
+  .dao-mcp-quick-setup-title {
+    color: var(--cr-primary-text-color);
+    font-size: 13px;
+    font-weight: 500;
+    line-height: 20px;
+  }
+
+  .dao-mcp-client {
+    color: var(--cr-secondary-text-color);
+    font-size: 12px;
+    line-height: 18px;
+    margin-top: 4px;
+  }
+
+  .dao-mcp-status-actions {
+    align-items: center;
+    display: flex;
+    gap: 8px;
+  }
+
+  .dao-mcp-status-badge {
+    border-radius: 999px;
+    font-size: 12px;
+    font-weight: 500;
+    line-height: 20px;
+    padding: 0 8px;
+  }
+
+  .dao-mcp-status-badge.disabled {
+    background: var(--google-grey-200);
+    color: var(--google-grey-700);
+  }
+
+  .dao-mcp-status-badge.ready {
+    background: var(--google-blue-100);
+    color: var(--google-blue-700);
+  }
+
+  .dao-mcp-status-badge.approval_requested {
+    background: var(--google-orange-100);
+    color: var(--google-orange-700);
+  }
+
+  .dao-mcp-status-badge.connected {
+    background: var(--google-green-100);
+    color: var(--google-green-700);
+  }
+
+  .dao-mcp-quick-setup-description,
+  .dao-mcp-client-label,
+  .dao-mcp-command-feedback {
+    color: var(--cr-secondary-text-color);
+    font-size: 12px;
+    line-height: 18px;
+  }
+
+  .dao-mcp-quick-setup-description {
+    margin-top: 2px;
+  }
+
+  .dao-mcp-client-label {
+    display: block;
+    margin-top: 12px;
+  }
+
+  .dao-mcp-client-selector {
+    background: var(--cr-card-background-color);
+    border: 1px solid var(--cr-separator-color);
+    border-radius: 8px;
+    color: var(--cr-primary-text-color);
+    font: inherit;
+    box-sizing: border-box;
+    margin-top: 6px;
+    min-height: 32px;
+    padding: 4px 10px;
+    width: 100%;
+  }
+
+  .dao-mcp-command-preview {
+    background: var(--cr-card-background-color);
+    border: 1px solid var(--cr-separator-color);
+    border-radius: 8px;
+    box-sizing: border-box;
+    color: var(--cr-primary-text-color);
+    display: block;
+    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
+        monospace;
+    font-size: 11px;
+    line-height: 18px;
+    margin-top: 10px;
+    max-height: 220px;
+    overflow: auto;
+    padding: 9px 10px;
+    white-space: pre;
+  }
+
+  .dao-mcp-copy-install-command {
+    margin: 0;
+  }
+
+  .dao-mcp-command-feedback {
+    margin-top: 4px;
+    min-height: 18px;
+  }
+
+  .dao-mcp-usage-header,
+  .dao-mcp-usage-row {
+    align-items: center;
+    display: flex;
+    gap: 12px;
+    justify-content: space-between;
+  }
+
+  .dao-mcp-usage-total,
+  .dao-mcp-usage-empty,
+  .dao-mcp-usage-row {
+    color: var(--cr-secondary-text-color);
+    font-size: 12px;
+    line-height: 18px;
+  }
+
+  .dao-mcp-usage-list {
+    display: grid;
+    gap: 8px;
+    margin-top: 12px;
+    max-height: 240px;
+    overflow-y: auto;
+  }
+
+  .dao-mcp-usage-count {
+    color: var(--cr-primary-text-color);
+    font-variant-numeric: tabular-nums;
+  }
+
+  .dao-local-agent-list {
+    display: grid;
+    gap: 8px;
+    margin-top: 12px;
+  }
+
+  .dao-local-agent-actions,
+  .dao-local-agent-row {
+    align-items: center;
+    color: var(--cr-primary-text-color);
+    display: flex;
+    font-size: 13px;
+    gap: 12px;
+    justify-content: space-between;
+  }
+
+  .dao-local-agent-row,
+  .dao-local-agent-actions {
+    flex-wrap: wrap;
+  }
+
+  @media (max-width: 520px) {
+    .dao-mcp-setup-controls {
+      align-items: stretch;
+      flex-direction: column;
+    }
+  }
+
+  .dao-local-agent-settings {
+    padding: 16px;
+  }
+</style>
+<settings-section page-title="$i18n{daoLocalAgentCollaborationTitle}"
+    section="localAgents">
+  <template is="dom-if" if="[[daoMcpSupported_]]">
+    <div class="dao-mcp-settings">
+      <settings-toggle-button id="daoMcpServerEnabled"
+          pref="{{daoMcpEnabledPref_}}"
+          label="$i18n{daoMcpServerEnabledLabel}"
+          sub-label="$i18n{daoMcpServerEnabledSubLabel}"
+          on-settings-boolean-control-change="onDaoMcpEnabledChange_">
+      </settings-toggle-button>
+      <template is="dom-if" if="[[showDaoMcpQuickSetup_]]" restamp>
+        <div id="daoMcpQuickSetup"
+            class="dao-mcp-section dao-mcp-quick-setup">
+          <div class="dao-mcp-quick-setup-title">
+            $i18n{daoMcpQuickSetupTitle}
+          </div>
+          <div class="dao-mcp-quick-setup-description">
+            $i18n{daoMcpQuickSetupDescription}
+          </div>
+          <div id="daoMcpSetupControls" class="dao-mcp-setup-controls">
+            <div class="dao-mcp-client-field">
+              <label class="dao-mcp-client-label" for="daoMcpClientSelector">
+                $i18n{daoMcpClientLabel}
+              </label>
+              <select id="daoMcpClientSelector" class="dao-mcp-client-selector"
+                  value="{{daoMcpSetupOption_::change}}"
+                  on-change="onDaoMcpSetupOptionChange_">
+                <option value="codex">$i18n{daoMcpClientCodex}</option>
+                <option value="claude-code">$i18n{daoMcpClientClaudeCode}</option>
+                <option value="generic-mcp">$i18n{daoMcpClientGeneric}</option>
+              </select>
+            </div>
+            <cr-button id="daoMcpCopySetup"
+                class="dao-mcp-copy-install-command"
+                disabled="[[!daoMcpSetupContent_]]"
+                on-click="onDaoMcpCopySetupContent_">
+              <template is="dom-if" if="[[!daoMcpGenericSetup_]]">
+                $i18n{daoMcpCopyInstallCommand}
+              </template>
+              <template is="dom-if" if="[[daoMcpGenericSetup_]]">
+                $i18n{daoMcpCopyConfiguration}
+              </template>
+            </cr-button>
+          </div>
+          <code id="daoMcpSetupPreview"
+              class="dao-mcp-command-preview">[[daoMcpSetupContent_]]</code>
+          <div id="daoMcpSetupFeedback"
+              class="dao-mcp-command-feedback" role="status"
+              aria-live="polite">
+            <template is="dom-if" if="[[daoMcpSetupCopied_]]">
+              <template is="dom-if" if="[[!daoMcpGenericSetup_]]">
+                $i18n{daoMcpInstallCommandCopied}
+              </template>
+              <template is="dom-if" if="[[daoMcpGenericSetup_]]">
+                $i18n{daoMcpConfigurationCopied}
+              </template>
+            </template>
+          </div>
+        </div>
+      </template>
+      <div id="daoMcpConnectionSection"
+          class="dao-mcp-section dao-mcp-status-section">
+        <div class="dao-mcp-status-copy">
+          <div class="dao-mcp-section-title">$i18n{daoMcpStatusLabel}</div>
+        </div>
+        <div class="dao-mcp-status-actions">
+          <span id="daoMcpStatusValue"
+              class$="dao-mcp-status-badge [[daoMcpStatusState_]]">
+            [[daoMcpStatusText_]]
+          </span>
+        </div>
+      </div>
+      <template is="dom-repeat" items="[[daoMcpConnections_]]" as="connection">
+        <div class="dao-mcp-section dao-mcp-connection">
+          <div class="dao-mcp-usage-header">
+            <div>
+              <div class="dao-mcp-client">[[getDaoMcpClientDetails_(connection)]]</div>
+              <div>[[connection.windowLabel]]</div>
+              <div>[[getDaoMcpScope_(connection.canCreateTabs)]]</div>
+              <div>[[connection.pageCountLabel]]</div>
+            </div>
+            <cr-button class="dao-mcp-stop-control"
+                data-connection-id$="[[connection.connectionId]]"
+                on-click="onDaoMcpStopControl_">
+              $i18n{daoMcpStopControl}
+            </cr-button>
+          </div>
+          <template is="dom-repeat" items="[[connection.tabs]]" as="tab">
+            <div class="dao-mcp-usage-header dao-mcp-page">
+              <div class="dao-mcp-status-copy">
+                <div>[[tab.title]]</div>
+                <div class="dao-mcp-page-url">[[tab.url]]</div>
+              </div>
+              <cr-button class="dao-mcp-revoke-tab"
+                  data-connection-id$="[[connection.connectionId]]"
+                  data-tab-id$="[[tab.tabId]]" on-click="onDaoMcpRevokeTab_">
+                $i18n{daoMcpRevokeTab}
+              </cr-button>
+            </div>
+          </template>
+        </div>
+      </template>
+      <div id="daoMcpUsageSection" class="dao-mcp-section">
+        <div class="dao-mcp-usage-header">
+          <div>
+            <div class="dao-mcp-section-title">$i18n{daoMcpUsageTitle}</div>
+            <div id="daoMcpUsageTotal" class="dao-mcp-usage-total">
+              $i18n{daoMcpUsageTotal}: [[daoMcpUsageTotal_]]
+            </div>
+          </div>
+          <cr-button id="daoMcpResetUsage"
+              disabled="[[!daoMcpUsageTotal_]]"
+              on-click="onDaoMcpResetUsage_">
+            $i18n{daoMcpUsageReset}
+          </cr-button>
+        </div>
+        <template is="dom-if" if="[[daoMcpUsageTools_.length]]" restamp>
+          <div id="daoMcpUsageList" class="dao-mcp-usage-list" role="list">
+            <template is="dom-repeat" items="[[daoMcpUsageTools_]]">
+              <div class="dao-mcp-usage-row" role="listitem">
+                <span>[[item.name]]</span>
+                <span class="dao-mcp-usage-count">[[item.count]]</span>
+              </div>
+            </template>
+          </div>
+        </template>
+        <template is="dom-if" if="[[!daoMcpUsageTools_.length]]" restamp>
+          <div id="daoMcpUsageEmpty" class="dao-mcp-usage-empty">
+            $i18n{daoMcpUsageNoCalls}
+          </div>
+        </template>
+      </div>
+    </div>
+    <div id="daoLocalAgentsSection" class="dao-local-agent-settings">
+      <div class="dao-mcp-usage-header">
+        <div class="dao-mcp-section-title">$i18n{daoLocalAgentsTitle}</div>
+        <cr-button id="daoLocalAgentsRefresh"
+            disabled="[[daoLocalAgentsBusy_]]"
+            on-click="refreshDaoLocalAgents_">
+          $i18n{daoLocalAgentsCheckUpdates}
+        </cr-button>
+      </div>
+      <div class="dao-mcp-quick-setup-description">
+        $i18n{daoLocalAgentsDescription}
+      </div>
+      <div id="daoLocalAgentList" class="dao-local-agent-list" role="list">
+        <template is="dom-repeat" items="[[daoLocalAgents_]]">
+          <div class="dao-local-agent-row" role="listitem">
+            <span id$="dao-local-agent-[[item.id]]">[[item.name]]</span>
+            <div class="dao-local-agent-actions" role="group"
+                aria-labelledby$="dao-local-agent-[[item.id]]">
+              <span class$="dao-mcp-status-badge [[item.badge]]">
+                [[item.status]]
+              </span>
+              <cr-button class="dao-local-agent-install"
+                  hidden$="[[!item.canInstall]]"
+                  data-id$="[[item.id]]" data-install="true"
+                  disabled="[[daoLocalAgentsBusy_]]"
+                  on-click="onDaoLocalAgentAction_">
+                [[item.action]]
+              </cr-button>
+              <cr-button class="dao-local-agent-uninstall"
+                  hidden$="[[!item.installed]]"
+                  data-id$="[[item.id]]" data-install="false"
+                  disabled="[[daoLocalAgentsBusy_]]"
+                  on-click="onDaoLocalAgentAction_">
+                $i18n{daoLocalAgentUninstall}
+              </cr-button>
+            </div>
+          </div>
+        </template>
+      </div>
+      <div role="alert" hidden$="[[!daoLocalAgentsError_]]">
+        [[daoLocalAgentsError_]]
+      </div>
+    </div>
+  </template>
+</settings-section>
