+
+/**
+ * @fileoverview
+ * 'settings-dao-page' contains the Dao settings overview.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_link_row/cr_link_row.js';
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_section.js';
+import '../settings_shared.css.js';
+
+import {WebUiListenerMixin} from 'chrome://resources/cr_elements/web_ui_listener_mixin.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {OpenWindowProxyImpl} from 'chrome://resources/js/open_window_proxy.js';
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {afterNextRender, PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import type {SettingsToggleButtonElement} from '../controls/settings_toggle_button.js';
+import {loadTimeData} from '../i18n_setup.js';
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+import {ContentSetting, ContentSettingsTypes} from '../site_settings/constants.js';
+import type {SiteSettingsBrowserProxy} from '../site_settings/site_settings_browser_proxy.js';
+import {SiteSettingsBrowserProxyImpl} from '../site_settings/site_settings_browser_proxy.js';
+
+import {getTemplate} from './dao_page.html.js';
+
+export interface DaoTabCategory {
+  id: string;
+  name: string;
+}
+
+export interface DaoFolderBrowserProxy {
+  getCategories(): Promise<DaoTabCategory[]>;
+  editCategory(operation: 'add'|'rename'|'remove', id: string, name: string):
+      Promise<DaoTabCategory[]>;
+}
+
+export class DaoFolderBrowserProxyImpl implements DaoFolderBrowserProxy {
+  getCategories(): Promise<DaoTabCategory[]> {
+    return sendWithPromise('getDaoTabCategories');
+  }
+
+  editCategory(operation: 'add'|'rename'|'remove', id: string, name: string):
+      Promise<DaoTabCategory[]> {
+    return sendWithPromise('editDaoTabCategory', operation, id, name);
+  }
+
+  static getInstance(): DaoFolderBrowserProxy {
+    return folderInstance ||
+        (folderInstance = new DaoFolderBrowserProxyImpl());
+  }
+
+  static setInstance(proxy: DaoFolderBrowserProxy): void {
+    folderInstance = proxy;
+  }
+}
+
+let folderInstance: DaoFolderBrowserProxy|null = null;
+
+export interface SettingsDaoPageElement {
+  $: {
+    staleTabExpirationHours: HTMLInputElement,
+  };
+  prefs: Record<string, unknown>;
+}
+
+const STALE_TAB_EXPIRATION_PRESETS: Array<[number, string]> = [
+  [24, 'daoStaleTabExpiration1Day'],
+  [72, 'daoStaleTabExpiration3Days'],
+  [120, 'daoStaleTabExpiration5Days'],
+  [168, 'daoStaleTabExpiration1Week'],
+  [336, 'daoStaleTabExpiration2Weeks'],
+];
+
+const SettingsDaoPageElementBase =
+    WebUiListenerMixin(PrefsMixin(PolymerElement));
+
+export class SettingsDaoPageElement extends SettingsDaoPageElementBase
+    implements SettingsPlugin {
+  static get is() {
+    return 'settings-dao-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      prefs: {
+        type: Object,
+        notify: true,
+      },
+      daoTabCategories_: {type: Array, value: () => []},
+      daoTabCategoryName_: {type: String, value: ''},
+      daoTabCategoryEditingId_: {type: String, value: ''},
+      daoTabCategoryAdding_: {type: Boolean, value: false},
+      daoTabCategoryError_: {type: String, value: ''},
+      daoTabCategoriesBusy_: {type: Boolean, value: false},
+      daoTabCategoriesLoaded_: {type: Boolean, value: false},
+      autoPipEnabledPref_: {
+        type: Object,
+        value() {
+          return {
+            key: 'auto-picture-in-picture',
+            type: chrome.settingsPrivate.PrefType.BOOLEAN,
+            value: true,
+          };
+        },
+      },
+      staleTabExpirationHoursInvalid_: {
+        type: Boolean,
+        value: false,
+      },
+      staleTabExpirationPresets_: {
+        type: Array,
+        value: () => STALE_TAB_EXPIRATION_PRESETS.map(
+            ([hours, label]) =>
+                ({hours, label: loadTimeData.getString(label)})),
+      },
+      staleTabExpirationCustom_: {
+        type: Boolean,
+        value: false,
+      },
+    };
+  }
+
+  static get observers() {
+    return [
+      'onStaleTabExpirationPrefChanged_(' +
+          'prefs.dao.stale_tab_expiration_hours.value)',
+    ];
+  }
+
+  declare prefs: Record<string, unknown>;
+  declare private autoPipEnabledPref_:
+      chrome.settingsPrivate.PrefObject<boolean>;
+  declare private daoTabCategories_: DaoTabCategory[];
+  declare private daoTabCategoryName_: string;
+  declare private daoTabCategoryEditingId_: string;
+  declare private daoTabCategoryAdding_: boolean;
+  declare private daoTabCategoryError_: string;
+  declare private daoTabCategoriesBusy_: boolean;
+  declare private daoTabCategoriesLoaded_: boolean;
+  private daoFolderBrowserProxy_: DaoFolderBrowserProxy =
+      DaoFolderBrowserProxyImpl.getInstance();
+  private daoTabCategoryRequest_ = 0;
+  private siteSettingsBrowserProxy_: SiteSettingsBrowserProxy =
+      SiteSettingsBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener(
+        'contentSettingCategoryChanged',
+        (category: ContentSettingsTypes) => {
+          if (category ===
+              ContentSettingsTypes.AUTO_PICTURE_IN_PICTURE) {
+            this.updateAutoPipEnabled_();
+          }
+        });
+    this.addWebUiListener(
+        'dao-tab-categories-changed',
+        () => void this.refreshDaoTabCategories_());
+    void this.refreshDaoTabCategories_();
+    this.updateAutoPipEnabled_();
+  }
+
+  private async refreshDaoTabCategories_() {
+    const request = ++this.daoTabCategoryRequest_;
+    try {
+      const categories = await this.daoFolderBrowserProxy_.getCategories();
+      if (request === this.daoTabCategoryRequest_) {
+        this.daoTabCategories_ = categories;
+        this.daoTabCategoriesLoaded_ = true;
+        if (!this.daoTabCategoriesBusy_) {
+          this.daoTabCategoryError_ = '';
+        }
+      }
+    } catch {
+      if (request === this.daoTabCategoryRequest_) {
+        this.daoTabCategoriesLoaded_ = false;
+        this.daoTabCategoryError_ =
+            loadTimeData.getString('daoTabCategoriesLoadError');
+      }
+    }
+  }
+
+  private onDaoTabCategoryRename_(event: Event) {
+    const id = (event.currentTarget as HTMLElement).dataset['id'];
+    const category = this.daoTabCategories_.find(item => item.id === id);
+    if (category) {
+      this.daoTabCategoryAdding_ = false;
+      this.daoTabCategoryEditingId_ = category.id;
+      this.daoTabCategoryName_ = category.name;
+      this.daoTabCategoryError_ = '';
+      this.focusDaoTabCategoryName_();
+    }
+  }
+
+  private onDaoTabCategoryAdd_() {
+    this.daoTabCategoryEditingId_ = '';
+    this.daoTabCategoryName_ = '';
+    this.daoTabCategoryError_ = '';
+    this.daoTabCategoryAdding_ = true;
+    this.focusDaoTabCategoryName_();
+  }
+
+  private focusDaoTabCategoryName_() {
+    afterNextRender(this, () => {
+      const input = this.shadowRoot!.querySelector<HTMLInputElement>(
+          '#daoTabCategoryName');
+      input?.focus();
+      input?.select();
+    });
+  }
+
+  private onDaoTabCategoryCancel_() {
+    this.daoTabCategoryAdding_ = false;
+    this.daoTabCategoryEditingId_ = '';
+    this.daoTabCategoryName_ = '';
+    this.daoTabCategoryError_ = '';
+  }
+
+  private onDaoTabCategoryNameInput_(event: Event) {
+    this.daoTabCategoryName_ = (event.target as HTMLInputElement).value;
+  }
+
+  private onDaoTabCategoryNameKeydown_(event: KeyboardEvent) {
+    if (event.isComposing) {
+      return;
+    }
+    if (event.key === 'Enter') {
+      event.preventDefault();
+      this.onDaoTabCategorySave_();
+    } else if (event.key === 'Escape') {
+      event.preventDefault();
+      this.onDaoTabCategoryCancel_();
+    }
+  }
+
+  private onDaoTabCategorySave_() {
+    const name = this.daoTabCategoryName_.trim();
+    if (!name || Array.from(name).length > 100) {
+      this.daoTabCategoryError_ =
+          loadTimeData.getString('daoTabCategoriesEditError');
+      return;
+    }
+    void this.editDaoTabCategory_(
+        this.daoTabCategoryEditingId_ ? 'rename' : 'add',
+        this.daoTabCategoryEditingId_, name);
+  }
+
+  private onDaoTabCategoryRemove_(event: Event) {
+    const id = (event.currentTarget as HTMLElement).dataset['id'];
+    if (id) {
+      void this.editDaoTabCategory_('remove', id, '');
+    }
+  }
+
+  private async editDaoTabCategory_(
+      operation: 'add'|'rename'|'remove', id: string, name: string) {
+    if (this.daoTabCategoriesBusy_ || !this.daoTabCategoriesLoaded_) {
+      return;
+    }
+    ++this.daoTabCategoryRequest_;
+    this.daoTabCategoriesBusy_ = true;
+    this.daoTabCategoryError_ = '';
+    try {
+      this.daoTabCategories_ =
+          await this.daoFolderBrowserProxy_.editCategory(operation, id, name);
+      this.onDaoTabCategoryCancel_();
+    } catch {
+      this.daoTabCategoryError_ =
+          loadTimeData.getString('daoTabCategoriesEditError');
+    } finally {
+      this.daoTabCategoriesBusy_ = false;
+    }
+  }
+
+  // The empty id is the in-place editor for a category being added.
+  private daoTabCategoryChips_(categories: DaoTabCategory[], adding: boolean):
+      DaoTabCategory[] {
+    return adding ? [...categories, {id: '', name: ''}] : categories;
+  }
+
+  private isDaoTabCategoryEditing_(id: string, editingId: string): boolean {
+    return id === editingId;
+  }
+
+  private daoTabCategoryControlsDisabled_(busy: boolean, loaded: boolean):
+      boolean {
+    return busy || !loaded;
+  }
+
+  private daoTabCategoryActionLabel_(key: string, name: string): string {
+    return loadTimeData.getStringF(key, name);
+  }
+
+  private async updateAutoPipEnabled_() {
+    const defaultValue =
+        await this.siteSettingsBrowserProxy_.getDefaultValueForContentType(
+            ContentSettingsTypes.AUTO_PICTURE_IN_PICTURE);
+    this.set(
+        'autoPipEnabledPref_.value',
+        defaultValue.setting !== ContentSetting.BLOCK);
+  }
+
+  private onAutoPipEnabledChange_() {
+    const enabled =
+        this.shadowRoot!
+            .querySelector<SettingsToggleButtonElement>('#autoPipEnabled')!
+            .checked;
+    this.siteSettingsBrowserProxy_.setDefaultValueForContentType(
+        ContentSettingsTypes.AUTO_PICTURE_IN_PICTURE,
+        enabled ? ContentSetting.ASK : ContentSetting.BLOCK);
+  }
+
+  declare private staleTabExpirationHoursInvalid_: boolean;
+  declare private staleTabExpirationPresets_:
+      Array<{hours: number, label: string}>;
+  declare private staleTabExpirationCustom_: boolean;
+
+  private onStaleTabExpirationPrefChanged_(value: number) {
+    if (Number.isInteger(value)) {
+      this.staleTabExpirationHoursInvalid_ = false;
+      // Stay in custom mode until a preset is chosen, even if the typed value
+      // happens to match one.
+      if (!STALE_TAB_EXPIRATION_PRESETS.some(([hours]) => hours === value)) {
+        this.staleTabExpirationCustom_ = true;
+      }
+    }
+  }
+
+  private staleTabExpirationPresetPressed_(
+      hours: number, value: number, custom: boolean): string {
+    return String(!custom && hours === value);
+  }
+
+  private ariaBoolean_(value: boolean): string {
+    return String(value);
+  }
+
+  private onStaleTabExpirationPresetClick_(event: Event) {
+    const hours =
+        Number((event.currentTarget as HTMLElement).dataset['hours']);
+    this.staleTabExpirationCustom_ = false;
+    this.staleTabExpirationHoursInvalid_ = false;
+    this.$.staleTabExpirationHours.value = String(hours);
+    this.setPrefValue('dao.stale_tab_expiration_hours', hours);
+  }
+
+  private onStaleTabExpirationCustomClick_() {
+    this.staleTabExpirationCustom_ = true;
+    this.$.staleTabExpirationHours.focus();
+  }
+
+  private isValidStaleTabExpirationHours_(value: string): boolean {
+    if (!/^\d+$/.test(value)) {
+      return false;
+    }
+
+    const hours = Number(value);
+    return Number.isInteger(hours) && hours >= 1 && hours <= 720;
+  }
+
+  private onStaleTabExpirationHoursInput_() {
+    this.staleTabExpirationHoursInvalid_ =
+        !this.isValidStaleTabExpirationHours_(
+            this.$.staleTabExpirationHours.value);
+  }
+
+  private onStaleTabExpirationHoursChange_() {
+    const value = this.$.staleTabExpirationHours.value;
+    if (!this.isValidStaleTabExpirationHours_(value)) {
+      this.staleTabExpirationHoursInvalid_ = true;
+      return;
+    }
+
+    this.staleTabExpirationHoursInvalid_ = false;
+    this.setPrefValue('dao.stale_tab_expiration_hours', Number(value));
+  }
+
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+
+  private onImportBrowserDataClick_() {
+    OpenWindowProxyImpl.getInstance().openUrl('dao://import/');
+  }
+
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-dao-page': SettingsDaoPageElement;
+  }
+}
+
+customElements.define(SettingsDaoPageElement.is, SettingsDaoPageElement);
