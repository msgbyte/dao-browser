 void BrowserCloseManager::CloseBrowsers() {
+#if BUILDFLAG(IS_WIN)
+  // Preserve session-only data only after every cancellation prompt has passed.
+  if (!browser_shutdown::ShouldIgnoreUnloadHandlers() &&
+      dao::DaoUpdaterService::GetInstance()->PrepareForExit()) {
+    chrome::PreserveSessionsForDaoUpdate();
+  }
+#endif
 #if BUILDFLAG(ENABLE_SESSION_SERVICE)
