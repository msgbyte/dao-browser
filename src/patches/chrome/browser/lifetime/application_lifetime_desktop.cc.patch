+void PreserveSessionsForDaoUpdate() {
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [](BrowserWindowInterface* browser) {
+        Profile* profile = browser->GetProfile();
+        if (!profile->IsOffTheRecord()) {
+          profile->SaveSessionState();
+#if BUILDFLAG(ENABLE_SESSION_SERVICE)
+          if (auto* service = SessionDataServiceFactory::GetForProfile(profile)) {
+            service->SetForceKeepSessionState();
+          }
+#endif
+        }
+        return true;
+      });
+}
+
 void AttemptRestart() {
   AttemptRestartInternal(IgnoreUnloadHandlers(false), RelaunchMode::kNormal);
 }
