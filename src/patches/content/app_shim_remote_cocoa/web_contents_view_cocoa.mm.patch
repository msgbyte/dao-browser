+
+- (void)recordDragTerminationEvent:(NSEvent*)event {
+  if (event.type == NSEventTypeKeyDown && event.keyCode == kVK_Escape) {
+    _dragSawEscape = YES;
+  } else if (event.type == NSEventTypeLeftMouseUp) {
+    _dragSawLeftMouseUp = YES;
+  }
+}
+
+- (void)startDragTerminationEventMonitor {
+  [self stopDragTerminationEventMonitor];
+  _dragSawEscape = NO;
+  _dragSawLeftMouseUp = NO;
+  WebContentsViewCocoa* __weak weakSelf = self;
+  _dragTerminationEventMonitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:(NSEventMaskKeyDown |
+                                            NSEventMaskLeftMouseUp)
+                                   handler:^NSEvent*(NSEvent* event) {
+                                     [weakSelf
+                                         recordDragTerminationEvent:event];
+                                     return event;
+                                   }];
+}
+
+- (void)stopDragTerminationEventMonitor {
+  if (_dragTerminationEventMonitor) {
+    [NSEvent removeMonitor:_dragTerminationEventMonitor];
+    _dragTerminationEventMonitor = nil;
+  }
 }
 
