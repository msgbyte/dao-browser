+bool IsInPrimaryPageTree(RenderFrameHostImpl* frame) {
+  auto* main_frame = frame->GetOutermostMainFrame();
+  if (main_frame->IsInPrimaryMainFrame()) {
+    return true;
+  }
+  // Guest main frames are not primary, including during cross-site swaps.
+  return main_frame->frame_tree()->is_guest() &&
+         !main_frame->IsPendingDeletion() &&
+         !main_frame->IsInBackForwardCache() &&
+         main_frame->GetOutermostMainFrameOrEmbedder()->IsInPrimaryMainFrame();
+}
