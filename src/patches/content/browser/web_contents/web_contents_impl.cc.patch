 void WebContentsImpl::SetPageFrozen(bool frozen) {
   TRACE_EVENT1("content", "WebContentsImpl::SetPageFrozen", "frozen", frozen);
 
+  if (frozen && dao::DaoHighPerformanceMode::IsEnabled(this)) {
+    return;
+  }
+
   // A visible page is never frozen.
   DCHECK_NE(Visibility::VISIBLE, GetVisibility());
 
   primary_frame_tree_.ForEachRenderViewHost(
       [&frozen](RenderViewHostImpl* rvh) { rvh->SetIsFrozen(frozen); });
+}
+
+void WebContentsImpl::OnHighPerformanceModeChanged() {
+  const bool enabled = dao::DaoHighPerformanceMode::IsEnabled(this);
+  if (enabled) {
+    primary_frame_tree_.ForEachRenderViewHost(
+        [](RenderViewHostImpl* host) { host->SetIsFrozen(false); });
+  }
+  UpdateVisibilityAndNotifyPageAndView(GetVisibility(), /*is_activity=*/false);
+  UpdateHighPerformanceWidgets();
+}
+
+void WebContentsImpl::UpdateHighPerformanceWidgets() {
+  ForEachRenderFrameHostImplIncludingSpeculative(
+      [this](RenderFrameHostImpl* frame) {
+        if (auto* widget = frame->GetLocalRenderWidgetHost()) {
+          widget->SetHighPerformanceMode(
+              dao::DaoHighPerformanceMode::IsEnabled(this) &&
+              IsInPrimaryPageTree(frame));
+        }
+      });
 }
 
