+void RenderWidgetHostImpl::SetHighPerformanceMode(bool enabled) {
+  high_performance_mode_ = enabled;
+  auto* manager = GetHostFrameSinkManager();
+  if (manager && manager->IsFrameSinkIdRegistered(GetFrameSinkId())) {
+    manager->SetFrameSinkThrottlingExempt(GetFrameSinkId(), enabled);
+  }
+  UpdatePriority();
+}
