+TEST_P(CompositorFrameSinkSupportTest,
+       ThrottlingExemptionStillThrottlesUnresponsiveClient) {
+  manager_->SetFrameSinkThrottlingExempt(kArbitraryFrameSinkId, true);
+  support_->SetNeedsBeginFrame(true);
+  constexpr base::TimeDelta interval = BeginFrameArgs::DefaultInterval();
+  base::TimeTicks frame_time;
+  uint64_t sequence_number = 1;
+  BeginFrameArgs args;
+
+  auto send_begin_frame = [&](base::TimeDelta elapsed) {
+    frame_time += elapsed;
+    args = CreateBeginFrameArgsForTesting(BEGINFRAME_FROM_HERE, 0,
+                                          sequence_number++, frame_time);
+    begin_frame_source_.TestOnBeginFrame(args);
+  };
+
+  for (int i = 0; i < BeginFrameTracker::kLimitThrottle; ++i) {
+    send_begin_frame(interval);
+    ASSERT_EQ(i + 1, fake_support_client_.begin_frame_count());
+  }
+  send_begin_frame(interval);
+  EXPECT_EQ(BeginFrameTracker::kLimitThrottle,
+            fake_support_client_.begin_frame_count());
+
+  for (int i = BeginFrameTracker::kLimitThrottle;
+       i < BeginFrameTracker::kLimitStop; ++i) {
+    send_begin_frame(base::Seconds(1));
+    ASSERT_EQ(i + 1, fake_support_client_.begin_frame_count());
+  }
+  const BeginFrameArgs last_sent_args = args;
+  send_begin_frame(base::Minutes(1));
+  EXPECT_EQ(BeginFrameTracker::kLimitStop,
+            fake_support_client_.begin_frame_count());
+
+  support_->DidNotProduceFrame(BeginFrameAck(last_sent_args, false));
+  send_begin_frame(interval);
+  EXPECT_EQ(BeginFrameTracker::kLimitStop + 1,
+            fake_support_client_.begin_frame_count());
+  support_->DidNotProduceFrame(BeginFrameAck(args, false));
+  support_->SetNeedsBeginFrame(false);
+}
