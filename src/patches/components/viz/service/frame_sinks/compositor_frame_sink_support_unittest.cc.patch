+TEST_P(CompositorFrameSinkSupportTest, ThrottlingExemptionKeepsUndrawnFrames) {
+  support_->SetNeedsBeginFrame(true);
+  manager_->SetFrameSinkThrottlingExempt(kArbitraryFrameSinkId, true);
+  constexpr base::TimeDelta interval = BeginFrameArgs::DefaultInterval();
+  base::TimeTicks frame_time;
+  uint64_t sequence_number = 1;
+  int received_frames = 0;
+  BeginFrameArgs args;
+  const SurfaceId surface_id(kArbitraryFrameSinkId, local_surface_id_);
+
+  // Respond to each BeginFrame without ever drawing the submitted surface.
+  for (uint32_t i = 0; i < CompositorFrameSinkSupport::kUndrawnFrameLimit + 2;
+       ++i) {
+    frame_time += interval;
+    args = CreateBeginFrameArgsForTesting(BEGINFRAME_FROM_HERE, 0,
+                                          sequence_number++, frame_time);
+    begin_frame_source_.TestOnBeginFrame(args);
+    ASSERT_EQ(++received_frames, fake_support_client_.begin_frame_count());
+    auto frame = MakeDefaultCompositorFrame();
+    frame.metadata.begin_frame_ack = BeginFrameAck(args, true);
+    support_->SubmitCompositorFrame(local_surface_id_, std::move(frame));
+    GetSurfaceForId(surface_id)->SendAckToClient();
+  }
+
+  // Capture still bypasses interval throttling when the explicit exemption
+  // ends.
+  support_->OnClientCaptureStarted();
+  manager_->SetFrameSinkThrottlingExempt(kArbitraryFrameSinkId, false);
+  EXPECT_FALSE(support_->GetThrottlerForTesting().throttling_allowed());
+  frame_time += interval;
+  args = CreateBeginFrameArgsForTesting(BEGINFRAME_FROM_HERE, 0,
+                                        sequence_number++, frame_time);
+  begin_frame_source_.TestOnBeginFrame(args);
+  EXPECT_EQ(received_frames, fake_support_client_.begin_frame_count());
+
+  manager_->SetFrameSinkThrottlingExempt(kArbitraryFrameSinkId, true);
+  frame_time += interval;
+  args = CreateBeginFrameArgsForTesting(BEGINFRAME_FROM_HERE, 0,
+                                        sequence_number++, frame_time);
+  begin_frame_source_.TestOnBeginFrame(args);
+  EXPECT_EQ(++received_frames, fake_support_client_.begin_frame_count());
+  support_->DidNotProduceFrame(BeginFrameAck(args, false));
+  support_->SetNeedsBeginFrame(false);
+  support_->OnClientCaptureStopped();
+}
+
