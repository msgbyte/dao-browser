+TEST_P(CompositorFrameSinkSupportTest,
+       SharedDescendantRetainsOtherAncestorsThrottlingExemption) {
+  constexpr FrameSinkId other_parent_id(7, 7);
+  for (const auto& id : {kAnotherArbitraryFrameSinkId, other_parent_id}) {
+    manager_->RegisterFrameSinkId(id, true);
+    manager_->RegisterFrameSinkHierarchy(id, kArbitraryFrameSinkId);
+    manager_->SetFrameSinkThrottlingExempt(id, true);
+  }
+  auto parent = std::make_unique<CompositorFrameSinkSupport>(
+      nullptr, manager_.get(), kAnotherArbitraryFrameSinkId, kIsRoot);
+  auto other_parent = std::make_unique<CompositorFrameSinkSupport>(
+      nullptr, manager_.get(), other_parent_id, kIsRoot);
+  support_->SetBeginFrameSource(&begin_frame_source_);
+  support_->SetNeedsBeginFrame(true);
+  constexpr base::TimeDelta interval = BeginFrameArgs::DefaultInterval();
+  base::TimeTicks frame_time;
+  uint64_t sequence_number = 1;
+  BeginFrameArgs args;
+
+  // Exceed the undrawn-frame limit so each check exercises both exemptions.
+  for (uint32_t i = 0; i < CompositorFrameSinkSupport::kUndrawnFrameLimit + 2;
+       ++i) {
+    frame_time += interval;
+    args = CreateBeginFrameArgsForTesting(BEGINFRAME_FROM_HERE, 0,
+                                          sequence_number++, frame_time);
+    const int received_frames = fake_support_client_.begin_frame_count();
+    begin_frame_source_.TestOnBeginFrame(args);
+    ASSERT_EQ(received_frames + 1, fake_support_client_.begin_frame_count());
+    auto frame = MakeDefaultCompositorFrame();
+    frame.metadata.begin_frame_ack = BeginFrameAck(args, true);
+    support_->SubmitCompositorFrame(local_surface_id_, std::move(frame));
+    GetSurfaceForId(SurfaceId(kArbitraryFrameSinkId, local_surface_id_))
+        ->SendAckToClient();
+  }
+
+  auto expect_exemption = [&](bool exempt) {
+    EXPECT_EQ(!exempt, support_->GetThrottlerForTesting().throttling_allowed());
+    const int received_frames = fake_support_client_.begin_frame_count();
+    frame_time += interval;
+    args = CreateBeginFrameArgsForTesting(BEGINFRAME_FROM_HERE, 0,
+                                          sequence_number++, frame_time);
+    begin_frame_source_.TestOnBeginFrame(args);
+    EXPECT_EQ(received_frames + (exempt ? 1 : 0),
+              fake_support_client_.begin_frame_count());
+    if (fake_support_client_.begin_frame_count() > received_frames) {
+      support_->DidNotProduceFrame(BeginFrameAck(args, false));
+    }
+  };
+
+  manager_->SetFrameSinkThrottlingExempt(kAnotherArbitraryFrameSinkId, false);
+  expect_exemption(true);
+  parent.reset();
+  expect_exemption(true);
+  parent = std::make_unique<CompositorFrameSinkSupport>(
+      nullptr, manager_.get(), kAnotherArbitraryFrameSinkId, kIsRoot);
+  expect_exemption(true);
+  manager_->SetFrameSinkThrottlingExempt(kAnotherArbitraryFrameSinkId, true);
+  manager_->InvalidateFrameSinkId(kAnotherArbitraryFrameSinkId, {});
+  expect_exemption(true);
+  manager_->RegisterFrameSinkId(kAnotherArbitraryFrameSinkId, true);
+  manager_->UnregisterFrameSinkHierarchy(kAnotherArbitraryFrameSinkId,
+                                         kArbitraryFrameSinkId);
+  expect_exemption(true);
+
+  manager_->SetFrameSinkThrottlingExempt(other_parent_id, false);
+  expect_exemption(false);
+  manager_->SetFrameSinkThrottlingExempt(other_parent_id, true);
+  expect_exemption(true);
+  manager_->UnregisterFrameSinkHierarchy(other_parent_id,
+                                         kArbitraryFrameSinkId);
+  expect_exemption(false);
+
+  support_->SetNeedsBeginFrame(false);
+  manager_->InvalidateFrameSinkId(kAnotherArbitraryFrameSinkId, {});
+  manager_->InvalidateFrameSinkId(other_parent_id, {});
+}
