+TEST_F(FrameSinkManagerTest, ThrottlingExemption) {
+  const std::vector<FrameSinkId> ids{kFrameSinkIdRoot, kFrameSinkIdA,
+                                     kFrameSinkIdB, kFrameSinkIdC,
+                                     kFrameSinkIdD};
+  for (const auto& id : ids) {
+    manager_->RegisterFrameSinkId(id, true);
+  }
+  auto root = CreateCompositorFrameSinkSupport(kFrameSinkIdRoot);
+  auto client_a = CreateCompositorFrameSinkSupport(kFrameSinkIdA);
+  auto client_b = CreateCompositorFrameSinkSupport(kFrameSinkIdB);
+  auto client_c = CreateCompositorFrameSinkSupport(kFrameSinkIdC);
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdC);
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdA, kFrameSinkIdB);
+
+  constexpr base::TimeDelta global_interval = base::Hertz(20);
+  constexpr base::TimeDelta interval = base::Hertz(10);
+  manager_->StartThrottlingAllFrameSinks(global_interval);
+  manager_->Throttle({kFrameSinkIdA}, interval);
+  manager_->SetFrameSinkThrottlingExempt(kFrameSinkIdA, true);
+  VerifyThrottling(base::TimeDelta(), {kFrameSinkIdA, kFrameSinkIdB});
+  VerifyAllowThrottling(false, {kFrameSinkIdA, kFrameSinkIdB});
+  VerifyThrottling(global_interval, {kFrameSinkIdRoot, kFrameSinkIdC});
+
+  // New supports inherit the exemption, including through a missing support.
+  client_a.reset();
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdA, kFrameSinkIdD);
+  auto client_d = CreateCompositorFrameSinkSupport(kFrameSinkIdD);
+  client_a = CreateCompositorFrameSinkSupport(kFrameSinkIdA);
+  VerifyThrottling(base::TimeDelta(),
+                   {kFrameSinkIdA, kFrameSinkIdB, kFrameSinkIdD});
+
+  // Full recomputations must keep the exemption and unrelated throttling.
+  manager_->Throttle({kFrameSinkIdA}, interval);
+  VerifyThrottling(base::TimeDelta(),
+                   {kFrameSinkIdA, kFrameSinkIdB, kFrameSinkIdD});
+  VerifyThrottling(global_interval, {kFrameSinkIdRoot, kFrameSinkIdC});
+
+  manager_->SetFrameSinkThrottlingExempt(kFrameSinkIdA, false);
+  VerifyThrottling(interval, {kFrameSinkIdA, kFrameSinkIdB, kFrameSinkIdD});
+  VerifyAllowThrottling(true, ids);
+
+  // Removing an exemption must leave real capture exemptions intact.
+  manager_->OnCaptureStarted(kFrameSinkIdB);
+  manager_->SetFrameSinkThrottlingExempt(kFrameSinkIdA, true);
+  manager_->SetFrameSinkThrottlingExempt(kFrameSinkIdA, false);
+  VerifyThrottling(base::TimeDelta(), {kFrameSinkIdB});
+  VerifyThrottling(interval, {kFrameSinkIdA, kFrameSinkIdD});
+  manager_->OnCaptureStopped(kFrameSinkIdB);
+  VerifyThrottling(interval, {kFrameSinkIdB});
+
+  // Invalidating the root clears its exemption even while hierarchy survives.
+  manager_->SetFrameSinkThrottlingExempt(kFrameSinkIdA, true);
+  manager_->InvalidateFrameSinkId(kFrameSinkIdA, {});
+  VerifyThrottling(interval, {kFrameSinkIdB, kFrameSinkIdD});
+  manager_->RegisterFrameSinkId(kFrameSinkIdA, true);
+  VerifyAllowThrottling(true, ids);
+
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdA, kFrameSinkIdD);
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdA, kFrameSinkIdB);
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdC);
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  for (const auto& id : ids) {
+    manager_->InvalidateFrameSinkId(id, {});
+  }
+}
