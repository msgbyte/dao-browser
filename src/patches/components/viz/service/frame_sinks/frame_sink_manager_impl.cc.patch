+void FrameSinkManagerImpl::SetFrameSinkThrottlingExempt(
+    const FrameSinkId& frame_sink_id,
+    bool exempt) {
+  if (!frame_sink_data_.contains(frame_sink_id)) {
+    return;
+  }
+  if (exempt) {
+    throttling_exempt_frame_sink_ids_.insert(frame_sink_id);
+  } else {
+    throttling_exempt_frame_sink_ids_.erase(frame_sink_id);
+  }
+  UpdateThrottlingRecursively(frame_sink_id);
+}
