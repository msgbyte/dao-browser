+void HostFrameSinkManager::SetFrameSinkThrottlingExempt(
+    const FrameSinkId& frame_sink_id,
+    bool exempt) {
+  auto it = frame_sink_data_map_.find(frame_sink_id);
+  CHECK(it != frame_sink_data_map_.end() && it->second.IsFrameSinkRegistered());
+  FrameSinkData& data = it->second;
+  if (data.throttling_exempt == exempt) {
+    return;
+  }
+  data.throttling_exempt = exempt;
+  if (frame_sink_manager_) {
+    frame_sink_manager_->SetFrameSinkThrottlingExempt(frame_sink_id, exempt);
+  }
+}
