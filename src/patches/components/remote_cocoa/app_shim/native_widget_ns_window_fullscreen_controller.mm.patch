+// TODO(dao): temporary fullscreen debugging logs, not product telemetry.
+void NativeWidgetNSWindowFullscreenController::LogFullscreenDiagnostic(
+    const char* event,
+    bool include_stack,
+    long window_number,
+    int64_t requested_display_id) const {
+  static os_log_t log = os_log_create("com.dao.browser", "fullscreen");
+  static uint64_t next_event_id = 0;
+  const uint64_t event_id = ++next_event_id;
+  const auto state_name = [](State state) {
+    switch (state) {
+      case State::kWindowed:
+        return "windowed";
+      case State::kWindowedMovingToFullscreenTarget:
+        return "moving-display";
+      case State::kEnterFullscreenTransition:
+        return "entering";
+      case State::kFullscreen:
+        return "fullscreen";
+      case State::kExitFullscreenTransition:
+        return "exiting";
+      case State::kWindowedRestoringOriginalFrame:
+        return "restoring-frame";
+      case State::kClosed:
+        return "closed";
+    }
+    return "unknown";
+  };
+  os_log(log,
+         "debug_only=1 layer=native id=%llu event=%{public}@ "
+         "controller=%{public}p window=%ld state=%{public}@ "
+         "target_fullscreen=%d transition=%d requested_display=%lld "
+         "pending_fullscreen=%d pending_display=%lld deferred_close=%d "
+         "restore_frame=%d",
+         static_cast<unsigned long long>(event_id), base::SysUTF8ToNSString(event),
+         static_cast<const void*>(this), window_number,
+         base::SysUTF8ToNSString(state_name(state_)),
+         GetTargetFullscreenState(), IsInFullscreenTransition(),
+         static_cast<long long>(requested_display_id),
+         pending_state_ ? static_cast<int>(pending_state_->is_fullscreen) : -1,
+         static_cast<long long>(pending_state_ ? pending_state_->display_id
+                                              : display::kInvalidDisplayId),
+         has_deferred_window_close_, restore_windowed_frame_);
+  if (include_stack) {
+    NSArray<NSString*>* stack = NSThread.callStackSymbols;
+    const NSUInteger count = std::min<NSUInteger>(stack.count, 24);
+    for (NSUInteger i = 0; i < count; ++i) {
+      os_log(log,
+             "debug_only=1 layer=native id=%llu controller=%{public}p "
+             "frame=%lu %{public}@",
+             static_cast<unsigned long long>(event_id),
+             static_cast<const void*>(this), static_cast<unsigned long>(i),
+             stack[i]);
+    }
+  }
+}
 
