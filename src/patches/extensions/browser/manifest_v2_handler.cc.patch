+bool ManifestV2Handler::IsAllowedByDaoPolicy(const ExtensionId& extension_id) {
+  const int availability = dao::DaoMV2PrefDefaults::GetManifestV2Availability(
+      user_prefs::UserPrefs::Get(browser_context_));
+  if (availability == 2) {
+    return true;
+  }
+  if (availability != 3 || extension_id.empty()) {
+    return false;
+  }
+
+  auto* management = ExtensionsBrowserClient::Get()->GetExtensionManagementClient(
+      browser_context_);
+  if (!management) {
+    return false;
+  }
+  const auto mode =
+      management->GetInstallationMode(extension_id, /*update_url=*/std::string());
+  return mode == ManagedInstallationMode::kForced ||
+         mode == ManagedInstallationMode::kRecommended;
+}
+
+void ManifestV2Handler::OnDaoManifestV2PolicyChanged() {
+  CheckDisabledExtensions();
+  DisableAffectedExtensions();
