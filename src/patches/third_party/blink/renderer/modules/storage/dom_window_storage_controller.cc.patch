+void DOMWindowStorageController::RecordHomeLocalStorageRead(
+    const String& key,
+    bool replaced_initial_document) {
+  if (!home_local_storage_read_keys_ && !replaced_initial_document) {
+    return;
+  }
+  std::optional<uint32_t> hash;
+  if (!key.IsNull()) {
+    if (!home_read_tracking_enabled_) {
+      auto* frame = GetSupplementable()->GetFrame();
+      home_read_tracking_enabled_ =
+          frame &&
+          Supplement<Page>::From<HomeStorageReadTracking>(frame->GetPage());
+    }
+    if (home_read_tracking_enabled_) {
+      hash = dao::HomeLocalStorageStringHash(key.RawByteSpan(), key.Is8Bit());
+    }
+  }
+  auto* controller = this;
+  while (dao::AddHomeStorageRead(controller->home_local_storage_read_keys_,
+                                 hash) ||
+         replaced_initial_document) {
+    // Initial empty children can disappear on their first real navigation.
+    auto* window = controller->GetSupplementable();
+    auto* frame = window->GetFrame();
+    if (!frame || (!replaced_initial_document &&
+                   frame->Loader().HasLoadedNonInitialEmptyDocument())) {
+      break;
+    }
+    replaced_initial_document = false;
+    auto* parent = DynamicTo<LocalFrame>(frame->Tree().Parent());
+    const auto* origin = window->GetSecurityOrigin();
+    if (!parent || !parent->DomWindow() || origin->IsOpaque()) {
+      break;
+    }
+    const auto* parent_origin = parent->DomWindow()->GetSecurityOrigin();
+    if (!controller->home_local_storage_read_keys_ ||
+        !origin->IsSameOriginWith(parent_origin) ||
+        !origin->CanAccess(parent_origin)) {
+      hash.reset();
+    }
+    controller = &From(*parent->DomWindow());
+  }
+}
