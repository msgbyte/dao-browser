+void DOMWindowStorageController::EnableHomeReadTracking(
+    LocalDOMWindow& window) {
+  auto* page = window.GetFrame() ? window.GetFrame()->GetPage() : nullptr;
+  if (page && !page->RequireSupplement<HomeStorageReadTracking>()) {
+    page->ProvideSupplement(
+        MakeGarbageCollected<HomeStorageReadTracking>(*page));
+  }
+}
