 }  // namespace blink
+
+namespace dao {
+namespace {
+
+blink::LocalDOMWindow* GetStorageWindow(blink::WebLocalFrame* frame) {
+  auto* local =
+      frame ? blink::To<blink::WebLocalFrameImpl>(frame)->GetFrame() : nullptr;
+  return local ? local->DomWindow() : nullptr;
+}
+
+}  // namespace
+
+base::Token GetHomeLocalStorageSourceId(blink::WebLocalFrame* frame) {
+  auto* window = GetStorageWindow(frame);
+  auto* storage =
+      window ? blink::DOMWindowStorage::localStorage(*window, IGNORE_EXCEPTION)
+             : nullptr;
+  return storage ? storage->SourceId() : base::Token();
+}
+
+void EnableHomeLocalStorageReadTracking(blink::WebLocalFrame* frame) {
+  if (auto* window = GetStorageWindow(frame)) {
+    blink::DOMWindowStorageController::EnableHomeReadTracking(*window);
+  }
+}
+
+HomeStorageReads GetHomeLocalStorageReadKeys(blink::WebLocalFrame* frame) {
+  auto* window = GetStorageWindow(frame);
+  return window ? blink::DOMWindowStorageController::From(*window)
+                      .HomeLocalStorageReadKeys()
+                : std::nullopt;
+}
+
+void MarkHomeLocalStorageDocumentReplaced(blink::WebLocalFrame* frame,
+                                          bool was_initial_document) {
+  if (auto* window = GetStorageWindow(frame)) {
+    blink::DOMWindowStorageController::From(*window).RecordHomeLocalStorageRead(
+        blink::String(), was_initial_document);
+  }
+}
+
+}  // namespace dao
