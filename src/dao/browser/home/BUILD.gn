import("//testing/test.gni")

source_set("file_snapshot") {
  sources = [
    "dao_home_error.h",
    "dao_home_file_snapshot.cc",
    "dao_home_file_snapshot.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//crypto" ]
}

if (is_mac || is_win) {
  # Reuse Chrome's implementation and launcher without its unrelated test cases.
  test("dao_home_browser_tests") {
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [
      "//dao/browser/cli/dao_home_entry_integration_unittest.cc",
      "//dao/browser/ui/webui/dao_home_external_ui_browsertest.cc",
      "dao_home_project_service_unittest.cc",
    ]
    deps = [
      ":file_snapshot",
      "//base",
      "//base/test:test_support",
      "//chrome/browser:browser_process",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/profiles:profile_test_util",
      "//chrome/browser/tab_list",
      "//chrome/browser/ui:ui",
      "//chrome/browser/ui/browser_window",
      "//chrome/common:constants",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//chrome/test/base:browser_tests_runner",
      "//components/prefs",
      "//components/tabs:public",
      "//content/public/browser",
      "//content/test:test_support",
      "//dao/browser/automation:browser_automation",
      "//dao/browser/mcp:browser_mcp",
      "//dao/browser/strings:dao_strings",
      "//net:test_support",
      "//testing/gtest",
      "//ui/base",
      "//ui/events",
      "//ui/views",
      "//ui/views:test_support",
    ]
    data_deps = [
      "//chrome:browser_tests_pak",
      "//dao/browser/cli:dao_browser_cli",
    ]
    if (is_mac) {
      # Exercise compatibility of the shared transport and skill installer.
      sources += [
        "//dao/browser/mcp/dao_mcp_foundation_unittest.cc",
        "//dao/browser/mcp/dao_mcp_service_browsertest.cc",
        "//dao/browser/ui/views/dao_test_init_mac.mm",
      ]
      data_deps += [
        "//chrome",
        "//chrome:chrome_framework",
      ]
    } else {
      data_deps += [ "//chrome:packed_resources" ]
    }
  }

  # Keep filesystem and commit checks runnable without the browser UI binary.
  test("dao_home_store_unittests") {
    sources = [
      "//base/test/run_all_unittests.cc",
      "//dao/browser/agent/dao_agent_workspace_types.cc",
      "//dao/browser/agent/dao_agent_workspace_types.h",
      "//dao/browser/agent/workspace/path_normalizer.cc",
      "//dao/browser/agent/workspace/path_normalizer.h",
      "//dao/browser/agent/workspace/text_only_filter.cc",
      "//dao/browser/agent/workspace/text_only_filter.h",
      "//dao/browser/agent/workspace/v4a_patch_applier.cc",
      "//dao/browser/agent/workspace/v4a_patch_applier.h",
      "//dao/browser/agent/workspace/v4a_patch_parser.cc",
      "//dao/browser/agent/workspace/v4a_patch_parser.h",
      "//dao/browser/agent/workspace/workspace_quota.cc",
      "//dao/browser/agent/workspace/workspace_quota.h",
      "//dao/browser/cli/dao_home_workspace_unittest.cc",
      "dao_home_experience.cc",
      "dao_home_experience.h",
      "dao_home_file_snapshot_unittest.cc",
      "dao_home_manifest.cc",
      "dao_home_manifest.h",
      "dao_home_project_store.cc",
      "dao_home_project_store.h",
      "dao_home_project_store_unittest.cc",
      "dao_home_types.cc",
      "dao_home_types.h",
    ]
    deps = [
      ":file_snapshot",
      "//base/test:test_support",
      "//crypto",
      "//dao/browser/cli:home_workspace",
      "//net",
      "//testing/gtest",
      "//url",
    ]
  }
}
