import("//dao/browser/dao_version.gni")

source_set("mcp_wire") {
  sources = [
    "dao_mcp_protocol.cc",
    "dao_mcp_protocol.h",
  ]

  public_deps = [
    "//base",
    "//dao/browser/automation:tool_types",
  ]
}

if (is_win) {
  source_set("mcp_win_support") {
    sources = [
      "dao_mcp_win_util.cc",
      "dao_mcp_win_util.h",
    ]
    public_deps = [ "//base" ]
    libs = [
      "advapi32.lib",
      "iphlpapi.lib",
      "ws2_32.lib",
    ]
  }
}

source_set("browser_mcp") {
  public_deps = [ ":mcp_wire" ]

  if (is_mac || is_win) {
    sources = [
      "dao_local_agent_integration.cc",
      "dao_local_agent_integration.h",
      "dao_mcp_connection.cc",
      "dao_mcp_connection.h",
      "dao_mcp_runtime_files.h",
      "dao_mcp_session_lifecycle_monitor.cc",
      "dao_mcp_session_lifecycle_monitor.h",
      "dao_mcp_transport.cc",
      "dao_mcp_transport.h",
    ]

    if (is_mac) {
      sources += [ "dao_mcp_runtime_files.mm" ]
    } else {
      sources += [ "dao_mcp_runtime_files_win.cc" ]
    }

    deps = [
      "//base",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/tab_list",
      "//chrome/browser/ui/browser_window",
      "//content/public/browser",
      "//crypto",
      "//dao/browser/automation:browser_automation",
      "//dao/browser/cli:dao_browser_entry_skill",
      "//dao/browser/cli:dao_lite_entry_skill",
      "//net",
    ]
    if (is_win) {
      deps += [ ":mcp_win_support" ]
    }
  }
}

if (is_mac || is_win) {
  # Socket client and MCP stdio server shared by dao-mcp and dao-browser.
  source_set("mcp_helper_core") {
    sources = [
      "helper/dao_mcp_browser_client.cc",
      "helper/dao_mcp_browser_client.h",
      "helper/dao_mcp_stdio_server.cc",
      "helper/dao_mcp_stdio_server.h",
    ]

    public_deps = [
      ":mcp_wire",
      "//base",
    ]
    if (is_win) {
      public_deps += [ "//net" ]
      deps = [ ":mcp_win_support" ]
    }
  }

  executable("dao_mcp_helper") {
    output_name = "dao-mcp"
    sources = [ "helper/main.cc" ]

    defines = [ "DAO_MCP_VERSION=\"$dao_display_version\"" ]
    if (is_mac) {
      frameworks = [ "Foundation.framework" ]
    }

    deps = [
      ":mcp_helper_core",
      "//base",
      "//chrome/common:constants",
    ]
  }
}

if (is_mac) {
  bundle_data("dao_mcp_helper_files") {
    sources = [ "$root_out_dir/dao-mcp" ]
    outputs = [ "{{bundle_contents_dir}}/Helpers/{{source_file_part}}" ]
    public_deps = [ ":dao_mcp_helper" ]
  }

  # Everything Dao ships in Contents/Helpers for local agents.
  group("dao_mcp_helper_bundle_data") {
    public_deps = [
      ":dao_mcp_helper_files",
      "//dao/browser/cli:dao_browser_cli_bundle_data",
    ]
  }
}
