<translation id="9191338038518226120">സൈഡ്ബാർ മാറ്റുക</translation>
<translation id="9205549548211212895">മൈഗ്രേഷൻ നിർത്തുക</translation>
<translation id="932327136139879170">ഹോം</translation>
<translation id="932413031402847895">ബ്രൗസർ ഡാറ്റ ഇറക്കുമതി ചെയ്യുക</translation>
<translation id="94779342469414120"><ph name="VALUE" /> - <ph name="DETAIL" /></translation>
<translation id="94889370059095136">തിരഞ്ഞെടുത്തവ കണക്റ്റ് ചെയ്യുക</translation>
<translation id="949725615797318423">എക്സ്റ്റൻഷനുകൾ അവയുടെ ഔദ്യോഗിക സ്റ്റോറിൽ നിന്ന് വീണ്ടും ഇൻസ്റ്റാൾ ചെയ്യും</translation>
<translation id="962181630102348889">നിങ്ങളുടെ ഹോം പ്രദർശിപ്പിക്കാനായില്ല</translation>
</translationbundle>
