<translation id="5322475253112112619">ಅನುಮತಿಸಿದರೆ, JavaScript ರನ್ ಮಾಡುವುದೂ ಸೇರಿ ನಿಮ್ಮ ಪ್ರಸ್ತುತ ಲಾಗಿನ್ ಬಳಸಿ ವೆಬ್‌ಸೈಟ್‌ಗಳನ್ನು ಓದಬಹುದು ಮತ್ತು ಸಂವಹನ ನಡೆಸಬಹುದು.</translation>
<translation id="5334844597069022743">ಮೂಲ ವೀಕ್ಷಿಸಿ</translation>
<translation id="5400726083793179041">ಆಯ್ಕೆಮಾಡಿದ ಯೋಜನೆಯ ಸ್ಥಿತಿಯನ್ನು ಹೊಸ ಆವೃತ್ತಿಯಾಗಿ ಪ್ರಕಟಿಸಲಾಗುತ್ತದೆ. ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಇತಿಹಾಸವು ಲಭ್ಯವಿರುತ್ತದೆ.</translation>
<translation id="5436835454512450295">ಆಮದು ಮಾಡಿದ ಬ್ರೌಸರ್ ಡೇಟಾ</translation>
