<translation id="6270944267518310103">ಕಾಯಲಾಗುತ್ತಿದೆ</translation>
<translation id="6299569859560607348">ಈ ಮುಖಪುಟವು ಬಾಹ್ಯ ಪುಟವನ್ನು ತೆರೆಯಲು ಬಯಸುತ್ತದೆ. ಮುಂದುವರಿಯುವ ಮೊದಲು ಗಮ್ಯಸ್ಥಾನವನ್ನು ಪರಿಶೀಲಿಸಿ.</translation>
<translation id="6325047129563993580">ನನ್ನ ಇತ್ತೀಚಿನ ಬ್ರೌಸಿಂಗ್ ಥೀಮ್‌ಗಳಿಂದ ನನ್ನ Dao ಮುಖಪುಟವನ್ನು ರಚಿಸಿ. ಗೌಪ್ಯತೆ-ಕಡಿಮೆಗೊಳಿಸಿದ ಮುಖಪುಟ ಇತಿಹಾಸದ ವಸ್ತುಗಳನ್ನು ಮಾತ್ರ ಬಳಸಿ, ದಿಕ್ಕನ್ನು ಸಂಕ್ಷಿಪ್ತವಾಗಿ ವಿವರಿಸಿ, ನಂತರ ಮೊದಲ ಆವೃತ್ತಿಯನ್ನು ನಿರ್ಮಿಸಿ ಮತ್ತು ಪ್ರಕಟಿಸಿ.</translation>
<translation id="642671119120438272">ಆಮದು ಮಾಡಿದ ಟ್ಯಾಬ್‌ಗಳು</translation>
<translation id="648743804821442565">ಸ್ಥಳೀಯ ಸ್ವಯಂಚಾಲಿತ ಕ್ಲೈಂಟ್ ಈ Dao ವಿಂಡೋಗೆ ಪ್ರವೇಶವನ್ನು ವಿನಂತಿಸುತ್ತಿದೆ.</translation>
<translation id="6527303717912515753">ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="6586201961110912838">ಈ ಆವೃತ್ತಿ ಮರುಸ್ಥಾಪಿಸಿ</translation>
<translation id="6601997535892446436">ಈ Mac ನಲ್ಲಿ ಬ್ರೌಸರ್ ಪ್ರೊಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ. ನೀವು ಏನನ್ನು ಸ್ಥಳಾಂತರಿಸುತ್ತೀರಿ ಎಂಬುದರ ನಿಯಂತ್ರಣ ನಿಮ್ಮಲ್ಲಿರಲು ಪ್ರತಿ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಪಟ್ಟಿ ಮಾಡಲಾಗಿದೆ.</translation>
