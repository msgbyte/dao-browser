    <output filename="dao_strings_kn.pak" type="data_package" lang="kn" />
    <output filename="dao_strings_ko.pak" type="data_package" lang="ko" />
    <output filename="dao_strings_ky.pak" type="data_package" lang="ky" />
    <output filename="dao_strings_lo.pak" type="data_package" lang="lo" />
    <output filename="dao_strings_lt.pak" type="data_package" lang="lt" />
    <output filename="dao_strings_lv.pak" type="data_package" lang="lv" />
