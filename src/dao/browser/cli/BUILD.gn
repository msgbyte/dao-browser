action("dao_home_help") {
  script = "embed_home_help.py"
  sources = [
    "//dao/browser/strings/dao_strings.grd",
    "//dao/browser/strings/translations/dao_strings_zh-CN.xtb",
  ]
  outputs = [ "$target_gen_dir/dao_home_help.h" ]
  args = [
    rebase_path("//tools/grit", root_build_dir),
    rebase_path(sources[0], root_build_dir),
    rebase_path(sources[1], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
  ]
}

if (is_mac || is_win) {
  source_set("home_workspace") {
    sources = [
      "dao_home_workspace.cc",
      "dao_home_workspace.h",
    ]
    public_deps = [
      "//base",
      "//dao/browser/home:file_snapshot",
    ]
    if (is_win) {
      deps = [ "//dao/browser/local_ipc:win_support" ]
    }
  }
}

if (is_mac || is_win) {
  executable("dao_browser_cli") {
    output_name = "dao-browser"
    sources = [
      "dao_browser_cli.cc",
      "dao_home_cli.cc",
      "dao_home_cli.h",
    ]

    defines = [ "DAO_MCP_VERSION=\"$dao_display_version\"" ]
    if (is_mac) {
      frameworks = [ "Foundation.framework", "CoreFoundation.framework" ]
    }

    deps = [
      ":dao_browser_guide",
      ":dao_lite_guide",
      ":dao_home_guide",
      ":dao_home_runtime_guide",
      ":dao_home_sources_guide",
      ":dao_home_help",
      ":home_workspace",
      "//dao/browser/local_ipc:client",
      "//base",
      "//chrome/common:constants",
      "//dao/browser/mcp:mcp_helper_core",
    ]
  }
}

if (is_mac) {
  bundle_data("dao_browser_cli_bundle_data") {
    sources = [ "$root_out_dir/dao-browser" ]
    outputs = [ "{{bundle_contents_dir}}/Helpers/{{source_file_part}}" ]
    public_deps = [ ":dao_browser_cli" ]
  }
}
