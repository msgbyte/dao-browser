import("//dao/browser/dao_version.gni")

# Embeds the agent guide so `dao-browser skill` always matches this build.
action("dao_browser_guide") {
  script = "embed_text.py"
  sources = [ "dao_browser_guide.md" ]
  outputs = [ "$target_gen_dir/dao_browser_guide.h" ]
  args = [
    rebase_path("dao_browser_guide.md", root_build_dir),
    rebase_path(outputs[0], root_build_dir),
    "kDaoBrowserGuide",
  ]
}

# The entry skill Dao installs for local agents. agent-plugins/ ships the
# same file.
action("dao_browser_entry_skill") {
  script = "embed_text.py"
  sources = [ "dao_browser_entry_skill.md" ]
