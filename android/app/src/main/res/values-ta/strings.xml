    <string name="usb_remote_debugging_enabled_summary">இயக்கப்பட்டது · அங்கீகரிக்கப்பட்ட ADB சாதனத்திற்காக காத்திருக்கிறது</string>
    <string name="remote_debugging_connection_guide">இணைப்பு வழிகாட்டி</string>
    <string name="remote_debugging_warning_title">USB தொலைநிலை பிழைத்திருத்தத்தை இயக்கவா?</string>
    <string name="remote_debugging_warning_body">இணைக்கப்பட்ட பிழைத்திருத்தி பக்க உள்ளடக்கம் மற்றும் பிணையக் கோரிக்கைகளைப் படிக்கலாம், மேலும் JavaScript-ஐ இயக்கலாம். நீங்கள் நம்பும் கணினிகளுக்கு மட்டும் அங்கீகாரம் வழங்கவும்.</string>
    <string name="enable_remote_debugging">எப்படியும் இயக்கு</string>
    <string name="remote_debugging_guide_title">Firefox பிழைத்திருத்தியை இணைக்கவும்</string>
    <string name="remote_debugging_guide_step_1">1. Android டெவலப்பர் விருப்பங்கள் மற்றும் USB பிழைத்திருத்தத்தை இயக்கவும்</string>
    <string name="remote_debugging_guide_step_2">2. உங்கள் கணினியை இணைத்து ADB பிழைத்திருத்தத்தை அங்கீகரிக்கவும்</string>
    <string name="remote_debugging_guide_step_3">3. டெஸ்க்டாப் Firefox-ல் about:debugging-ஐத் திறக்கவும்</string>
    <string name="remote_debugging_desktop_note">உங்கள் கணினியில் Firefox-ல் இந்த முகவரியைத் திறந்து, Android சாதனத்தைத் தேர்ந்தெடுத்து, பின்னர் ஒரு Dao தாவலை ஆய்வு செய்யவும்.</string>
    <string name="open_developer_options">டெவலப்பர் விருப்பங்களைத் திறக்கவும்</string>
